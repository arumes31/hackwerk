# Development-only example. Never reuse these credentials in production.
APP_ENV=development
APP_NAME=HackWerk
APP_BASE_URL=http://localhost:18533
APP_LISTEN_ADDR=:18533
APP_TIMEZONE=Europe/Vienna
APP_LOCALE=de-AT
APP_LOG_LEVEL=info
APP_LOG_FORMAT=json
APP_SHUTDOWN_TIMEOUT=20s

DATABASE_URL=postgres://hackplan_app:development-only@postgres:5432/hackplan?sslmode=disable
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=2
DATABASE_CONNECT_TIMEOUT=5s
DATABASE_READINESS_TIMEOUT=2s

# Prefer DATABASE_URL_FILE=/run/secrets/database_url in production.

SESSION_COOKIE_NAME=hackplan_session
SESSION_IDLE_TTL=8h
SESSION_ABSOLUTE_TTL=24h
SESSION_COOKIE_SECURE=false
PASSWORD_MIN_LENGTH=14
LOGIN_RATE_LIMIT_PER_MINUTE=10
