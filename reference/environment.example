# Non-secret example only. Do not put production credentials here.
APP_ENV=development
APP_NAME=HackWerk
APP_BASE_URL=http://localhost:18533
APP_LISTEN_ADDR=:18533
APP_TIMEZONE=Europe/Vienna
APP_LOCALE=de-AT
APP_TRUSTED_PROXY_CIDRS=
APP_ALLOWED_HOSTS=localhost,127.0.0.1,::1
APP_LOG_LEVEL=info
APP_LOG_FORMAT=json
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_HEADER_BYTES=1048576
HTTP_MAX_BODY_BYTES=16777216
INTERNAL_RATE_LIMIT_PER_MINUTE=600
MAINTENANCE_MODE=false

DATABASE_URL=postgres://hackplan:development-only@postgres:5432/hackplan?sslmode=disable
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=2

SESSION_COOKIE_NAME=hackwerk_session
CSRF_COOKIE_NAME=hackwerk_csrf
SESSION_IDLE_TTL=8h
SESSION_ABSOLUTE_TTL=24h
SESSION_COOKIE_SECURE=false
PASSWORD_MIN_LENGTH=14
LOGIN_RATE_LIMIT_PER_MINUTE=10

MAIL_ENABLED=false
MAIL_SMTP_HOST=smtp.example.invalid
MAIL_SMTP_PORT=587
MAIL_SMTP_TLS=starttls
MAIL_FROM_ADDRESS=hackwerk@example.invalid
MAIL_FROM_NAME=HackWerk
MAIL_MAX_ATTEMPTS=6
# MAIL_SMTP_USERNAME_FILE=/run/secrets/smtp_username
# MAIL_SMTP_PASSWORD_FILE=/run/secrets/smtp_password

SMS_PROVIDER=sendberry
SMS_ENABLED=false
SENDBERRY_API_URL=https://api.sendberry.com/SMS/SEND
SENDBERRY_API_KEY=
SENDBERRY_ACCESS_NAME=
SENDBERRY_ACCESS_PASSWORD=
# Alternativ können die drei Secrets über *_FILE-Variablen gesetzt werden.
# SENDBERRY_API_KEY_FILE=/run/secrets/sendberry_api_key
# SENDBERRY_ACCESS_NAME_FILE=/run/secrets/sendberry_access_name
# SENDBERRY_ACCESS_PASSWORD_FILE=/run/secrets/sendberry_access_password
SMS_SENDER=SMS Inform
SMS_WEBHOOK_URL=
SMS_TIMEOUT=8s
SMS_MAX_ATTEMPTS=6
# SMS_WEBHOOK_HMAC_SECRET_FILE=/run/secrets/sms_hmac

VOICE_ENABLED=false
VOICE_TRANSCRIBER=disabled
VOICE_EXTRACTOR=rules
VOICE_OPENAI_API_KEY=
# VOICE_OPENAI_API_KEY_FILE=/run/secrets/voice_openai_api_key
VOICE_OPENAI_MODEL=gpt-4o-mini-transcribe
VOICE_OPENAI_EXTRACTION_MODEL=gpt-5-mini
VOICE_FAKE_TRANSCRIPT=
VOICE_MAX_DURATION=90s
VOICE_MAX_BYTES=15728640
VOICE_DRAFT_RETENTION=24h
VOICE_PROVIDER_TIMEOUT=30s
VOICE_MAX_RESPONSE_BYTES=1048576
VOICE_TEMP_DIR=/tmp/hackwerk-voice
VOICE_RATE_LIMIT_PER_MINUTE=10
VOICE_CONCURRENT_PER_USER=2
VOICE_EXTERNAL_PROVIDER_NOTICE=Bei aktivem externem Sprachdienst verlassen Audio und/oder Transkript zur Verarbeitung die HackWerk-Infrastruktur.
# OPENAI_API_KEY_FILE=/run/secrets/openai_api_key

PLANNING_ROUTER=haversine
PLANNING_ROUTING_URL=
PLANNING_ROUTING_TIMEOUT=5s
PLANNING_ROUTING_MAX_RESPONSE_BYTES=1048576
PLANNING_ROUTING_BACKOFF=30s
PLANNING_ROUTING_CACHE_TTL=1h
PLANNING_ROUTING_CACHE_ENTRIES=512
PLANNING_SLOT_MINUTES=15
PLANNING_BUFFER_MINUTES=15
PLANNING_HORIZON_DAYS=56
PLANNING_CANDIDATE_LIMIT=2500
PLANNING_SUGGESTION_TTL=30m
PLANNING_BUSINESS_OPEN=07:00
PLANNING_BUSINESS_CLOSE=17:00
PLANNING_DEPOT_LATITUDE=48.2
PLANNING_DEPOT_LONGITUDE=14.2
PLANNING_HAVERSINE_ROAD_FACTOR=1.3
PLANNING_HAVERSINE_SPEED_KMH=55
PLANNING_WEIGHT_PREFERENCE=25
PLANNING_WEIGHT_TRAVEL=25
PLANNING_WEIGHT_DRIVER=15
PLANNING_WEIGHT_RESOURCE=10
PLANNING_WEIGHT_UTILIZATION=10
PLANNING_WEIGHT_URGENCY=10
PLANNING_WEIGHT_REGION=5

MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_TOKEN=
# MAP_TILE_TOKEN_FILE=/run/secrets/map_tile_token
MAP_TILE_ATTRIBUTION=© OpenStreetMap-Mitwirkende
MAP_TILE_TIMEOUT=8s
MAP_TILE_MAX_RESPONSE_BYTES=2097152
MAP_TILE_MAX_ZOOM=19

DASHBOARD_HORIZON_DAYS=14
DASHBOARD_PENDING_AFTER=15m
DASHBOARD_BUSINESS_OPEN=07:00
DASHBOARD_BUSINESS_CLOSE=17:00
CALENDAR_UID_DOMAIN=hackwerk.local
CALENDAR_ENABLED=true
CALENDAR_NAME=HackWerk Termine
CALENDAR_EXPORT_MAX_DAYS=366
CALENDAR_FEED_HISTORY_DAYS=90
CALENDAR_FEED_FUTURE_DAYS=366
CALENDAR_FEED_RATE_LIMIT=120

METRICS_ENABLED=true
METRICS_LISTEN_ADDR=127.0.0.1:19090
METRICS_COLLECTION_TIMEOUT=2s
WORKER_HEARTBEAT_STALE_AFTER=2m

CONFIRMATION_TOKEN_TTL=336h
CONFIRMATION_TOKEN_KEY_ID=production-v1
# CONFIRMATION_TOKEN_KEYS_FILE=/run/secrets/confirmation_token_keys_json
CONFIRMATION_RATE_LIMIT_PER_MINUTE=30
WORKER_POLL_INTERVAL=1s
WORKER_LEASE=30s
WORKER_BATCH_SIZE=20
CALENDAR_FEED_CACHE_SECONDS=300

METRICS_ENABLED=true
METRICS_LISTEN_ADDR=:9090

# Prefer *_FILE variants and Docker secrets in production.
