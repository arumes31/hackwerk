[Unit]
Description=Build and activate HackWerk OSRM border-region data
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
Environment=HACKWERK_DEPLOYMENT_DIR=/container/hackwerk
Environment=HACKWERK_COMPOSE_FILE=compose.yaml
Environment=OSRM_DATA_DIR=/container/hackwerk/data/osrm
Environment=OSRM_IMAGE=hackwerk-osrm-tools:v26.7.3-2
ExecStart=/container/hackwerk/scripts/ops/update-osrm-host.sh
Nice=15
IOSchedulingClass=idle
IOSchedulingPriority=7
