package templates

import (
	"example.invalid/hackplan/internal/planning"
	"fmt"
	"net/url"
	"sort"
	"strings"
	"time"
)

type PlanningData struct {
	Shell            ShellData
	JobID            string
	Run              *planning.Run
	Error            string
	Clusters         []planning.ClusterHint
	Candidates       []planning.RouteCandidate
	MissingLocations []planning.RouteMissingLocation
	ReturnTo         string
}

func (d PlanningData) WithError(value string) PlanningData {
	d.Error = value
	return d
}

templ Planning(data PlanningData) {
	<!DOCTYPE html>
	<html lang="de-AT">
		@documentHead(data.Shell.Page, "Planungsvorschläge – "+data.Shell.Page.AppName)
		<body>
			@appHeader(data.Shell)
			<main id="hauptinhalt" class="page planning-page" data-planning-workbench>
				<div class="page-heading"><div><p class="eyebrow">Disposition</p><h1>Planungswerkbank</h1><p>Aufträge auswählen, prüfen und als Einzelvorschlag oder Tagesroute bearbeiten. Jede Übernahme bleibt unverbindlich.</p></div><div class="action-row"><a class="button button--quiet" href={ data.ReturnTo }>Zurück zur Warteliste</a><span class="status-badge">Keine automatische Fixierung</span></div></div>
				if data.Error != "" {
					<div class="form-alert" role="alert">{ data.Error }</div>
				}
				<nav class="planning-mode-tabs" aria-label="Planungsmodus"><a class="button" href="/planning" aria-current="page">Einzelauftrag</a><a class="button button--quiet" href="/planning/routes">Tagesroute</a><a class="button button--quiet" href="/availability">Kapazität</a></nav>
				<ol class="planning-progress" aria-label="Planungsfortschritt"><li class="is-active"><span>1</span>Auftrag</li><li><span>2</span>Rahmen</li><li><span>3</span>Vorschläge</li><li><span>4</span>Übernahme</li></ol>
				<form id="planning-route-selection" method="get" action="/planning/routes"></form>
				<section class="planning-workspace route-workspace" data-route-context>
					<div class="planning-orders form-card">
						<div class="section-heading"><div><p class="eyebrow">Auftragsvorrat</p><h2>Aufträge</h2></div><span class="status-badge">{ fmt.Sprint(len(data.Candidates)) } vollständig</span></div>
						<label class="planning-search">Suchen<input type="search" placeholder="Auftrag, Kunde, Ort oder Region" data-planning-search autocomplete="off"/></label>
						<div class="planning-filter-row">
							<label>
								Region 
								<select data-planning-region>
									<option value="">Alle Regionen</option>
									for _, region := range planningRegions(data.Candidates) {
										<option value={ region }>{ region }</option>
									}
								</select>
							</label>
							<label>Radius ab Depot (km)<input type="number" min="1" max="250" step="1" placeholder="Alle" data-planning-radius/></label><button type="button" class="button button--quiet" data-planning-select-visible>Sichtbare wählen</button><button type="button" class="button button--quiet" data-planning-reset>Zurücksetzen</button>
						</div>
						<div class="route-candidate-list planning-order-list" data-planning-order-list>
							for _, candidate := range data.Candidates {
								<div class="route-candidate planning-order-row" data-route-candidate data-planning-order data-job-id={ candidate.JobID } data-search={ strings.ToLower(candidate.JobNumber + " " + candidate.CustomerName + " " + candidate.Locality + " " + candidate.Region) } data-region={ candidate.Region } data-latitude={ routeCoordinate(candidate.Location.Latitude) } data-longitude={ routeCoordinate(candidate.Location.Longitude) } data-label={ candidate.JobNumber } data-customer={ candidate.CustomerName } data-volume={ candidate.VolumeM3 } data-duration-minutes={ fmt.Sprint(int(candidate.WorkDuration / time.Minute)) } data-unavailable-reason={ candidate.UnavailableReason }>
									<input form="planning-route-selection" type="checkbox" name="job_id" value={ candidate.JobID } aria-label={ candidate.JobNumber + " auswählen" } disabled?={ candidate.UnavailableReason != "" }/>
									<button type="button" class="planning-order-detail" data-planning-detail aria-label={ "Details zu " + candidate.JobNumber }><strong>{ candidate.JobNumber }</strong><span>{ candidate.CustomerName }</span><small>{ candidate.Locality } · { candidate.Region } · { candidate.VolumeM3 } m³ · { planningDurationShort(candidate.WorkDuration) }</small></button>
									if candidate.UnavailableReason != "" {
										<span class="status-badge">{ candidate.UnavailableReason }</span>
									}
								</div>
							}
							if len(data.Candidates) == 0 {
								<div class="empty-state"><h3>Keine vollständigen Aufträge</h3><p>Erfassen Sie zuerst einen aktiven Wartelistenauftrag.</p></div>
							}
						</div>
						if len(data.MissingLocations) > 0 {
							<details class="compact-filter-panel planning-missing">
								<summary><strong>{ fmt.Sprint(len(data.MissingLocations)) } unvollständige Aufträge</strong></summary>
								<p>Für diese Aufträge fehlt der Haufenstandort. Ergänzen Sie ihn direkt in den Auftragsdaten.</p>
								<ul>
									for _, item := range data.MissingLocations {
										<li><a href={ "/customers?job=" + url.QueryEscape(item.JobNumber) }>{ item.JobNumber } · { item.CustomerName }</a></li>
									}
								</ul>
							</details>
						}
					</div>
					<div class="planning-map-panel route-map-panel">
						@mapAssetData(data.Shell.Page)
						<div class="section-heading"><div><p class="eyebrow">Karte</p><h2>Standorte</h2></div><span class="status-badge" data-route-map-count></span></div>
						<div class="route-map-toolbar" data-route-map-toolbar></div>
						<div class="route-map planning-map" role="region" aria-label="Interaktive Karte der Planungsaufträge" data-route-map data-depot-latitude="48.200000" data-depot-longitude="14.200000"><div class="map-fallback" data-map-fallback>Die Karte wird geladen. Die Auftragsliste bleibt vollständig bedienbar.</div></div>
					</div>
					<aside class="planning-selection form-card" aria-live="polite">
						<div class="section-heading"><div><p class="eyebrow">Aktuelle Auswahl</p><h2 data-planning-selection-title>Noch nichts gewählt</h2></div></div>
						<dl class="planning-selection-metrics"><div><dt>Aufträge</dt><dd data-planning-count>0</dd></div><div><dt>Menge</dt><dd data-planning-volume>0 m³</dd></div><div><dt>Arbeit</dt><dd data-planning-duration>0 Min.</dd></div></dl>
						<div class="planning-detail-panel" data-planning-detail-panel><p>Wählen Sie einen Auftrag für die kompakte Zusammenfassung.</p></div>
						<form method="post" action="/planning/suggestions" class="form-stack planning-single-form">
							<input type="hidden" name="csrf_token" value={ data.Shell.CSRFToken }/><input type="hidden" name="return_to" value={ data.ReturnTo }/>
							<label>
								Einzelauftrag
								<select name="job_id" data-planning-single required>
									<option value="">Bitte wählen</option>
									if data.JobID != "" && !planningContainsJob(data.Candidates, data.MissingLocations, data.JobID) {
										<option value={ data.JobID } selected>Aus Warteliste ausgewählter Auftrag</option>
									}
									for _, candidate := range data.Candidates {
										if candidate.UnavailableReason == "" {
											<option value={ candidate.JobID } selected?={ candidate.JobID == data.JobID }>{ candidate.JobNumber } · { candidate.CustomerName }</option>
										}
									}
									for _, candidate := range data.MissingLocations {
										<option value={ candidate.JobID } selected?={ candidate.JobID == data.JobID }>{ candidate.JobNumber } · { candidate.CustomerName } · Standort unvollständig</option>
									}
								</select>
							</label><button class="button" type="submit">Top-3 berechnen</button>
						</form>
						<button form="planning-route-selection" class="button button--quiet" type="submit" data-planning-route disabled>Auswahl als Tagesroute planen</button>
						<p class="form-hint">Die Berechnung legt keinen Termin an und versendet keine Nachricht.</p>
					</aside>
				</section>
				if len(data.Clusters) > 0 {
					<section class="module-card" aria-labelledby="cluster-title">
						<div class="section-heading"><h2 id="cluster-title">Geografische Gruppenhinweise</h2><span class="status-badge">Nur Hinweis</span></div>
						for _, cluster := range data.Clusters {
							<article class="planning-warning"><p><strong>{ fmt.Sprint(cluster.Count) } Aufträge liegen geografisch nahe.</strong> Gemeinsame Planung kann Wege reduzieren.</p><a href={ "/waitlist?region=" + url.QueryEscape(cluster.Region) }>Betroffene Warteliste filtern</a></article>
						}
					</section>
				}
				if data.Run != nil {
					<section class="module-card" aria-labelledby="suggestions-title">
						<div class="section-heading"><div><p class="eyebrow">Berechnung { planningShortID(data.Run.ID) }</p><h2 id="suggestions-title">Bis zu drei valide Optionen</h2></div><form method="post" action="/planning/suggestions"><input type="hidden" name="csrf_token" value={ data.Shell.CSRFToken }/><input type="hidden" name="return_to" value={ data.ReturnTo }/><input type="hidden" name="job_id" value={ data.Run.JobID }/><button class="button button--quiet" type="submit">Neu berechnen</button></form></div>
						<div class="suggestion-grid">
							for _, item := range data.Run.Suggestions {
								<article class="suggestion-card" data-suggestion-rank={ fmt.Sprint(item.Rank) }>
									<div class="job-card__heading"><div><p class="eyebrow">Option { fmt.Sprint(item.Rank) }</p><h3>{ planningLocal(item.StartsAt) }–{ planningLocalTime(item.EndsAt) }</h3></div><span class="status-badge">{ fmt.Sprintf("%.1f / 100", item.Score) }</span></div>
									if item.Rank == 1 {
										<p class="best-option"><span aria-hidden="true">★</span> Beste berechnete Option – keine Garantie</p>
									}
									<dl class="suggestion-facts"><div><dt>Dauer</dt><dd>{ planningDuration(item.StartsAt,item.EndsAt) }</dd></div><div><dt>Fahrer</dt><dd>{ item.DriverName }</dd></div><div><dt>Ressourcen</dt><dd>{ planningList(item.ResourceNames) }</dd></div><div><dt>Transport</dt><dd>{ planningTransport(item.ResourcePurposes) }</dd></div><div><dt>Distanzquelle</dt><dd>{ planningSource(item.RoutingSource) }</dd></div></dl>
									<p class="preference-fit" data-fit={ planningPreferenceClass(item.Components.Preference) }><strong>Wunschzeitraum:</strong> { planningPreferenceLabel(item.Components.Preference) }</p>
									<h4>Warum diese Option?</h4>
									<ul>
										for _, reason := range item.Reasons {
											<li>{ reason }</li>
										}
									</ul>
									if len(item.Warnings) > 0 {
										<div class="planning-warning" role="note">
											<strong>Hinweis</strong>
											<ul>
												for _, warning := range item.Warnings {
													<li>{ warning }</li>
												}
											</ul>
										</div>
									}
									<div class="action-row"><form method="post" action={ "/planning/suggestions/" + item.ID + "/adopt" }><input type="hidden" name="csrf_token" value={ data.Shell.CSRFToken }/><input type="hidden" name="return_to" value={ data.ReturnTo }/><input type="hidden" name="run_id" value={ data.Run.ID }/><input type="hidden" name="job_id" value={ data.Run.JobID }/><button class="button" type="submit" disabled?={ item.Status != "pending" }>Vorschlag übernehmen</button></form><a class="button button--quiet" href={ "/calendar?date=" + item.StartsAt.In(viennaLocation()).Format(time.DateOnly) }>Im Kalender ansehen</a></div><small>Status: { planningStatus(item.Status) } · gültig bis { planningLocal(item.ExpiresAt) }</small>
								</article>
							}
						</div>
					</section>
				}
			</main>
			@appFooter(data.Shell.Page)
		</body>
	</html>
}

func planningLocal(value time.Time) string {
	location, _ := time.LoadLocation("Europe/Vienna")
	return value.In(location).Format("Mo, 02.01.2006 · 15:04")
}
func planningLocalTime(value time.Time) string {
	location, _ := time.LoadLocation("Europe/Vienna")
	return value.In(location).Format("15:04")
}
func planningDuration(a, b time.Time) string {
	return fmt.Sprintf("%d Minuten", int(b.Sub(a).Minutes()))
}
func planningList(values []string) string {
	if len(values) == 0 {
		return "—"
	}
	result := ""
	for i, v := range values {
		if i > 0 {
			result += ", "
		}
		result += v
	}
	return result
}
func planningTransport(values []string) string {
	for _, v := range values {
		if v == "transport" {
			return "intern eingeplant"
		}
	}
	return "nicht erforderlich oder extern bestätigt"
}
func planningSource(value string) string {
	if value == "osrm" {
		return "Routingprovider"
	}
	if value == "haversine" {
		return "Luftlinie / Schätzung"
	}
	return "keine Koordinaten"
}
func planningStatus(value string) string {
	labels := map[string]string{"pending": "verfügbar", "adopted": "übernommen", "discarded": "verworfen", "stale": "veraltet"}
	if label := labels[value]; label != "" {
		return label
	}
	return value
}

func planningDurationShort(value time.Duration) string {
	return fmt.Sprintf("%d Min.", int(value/time.Minute))
}
func planningShortID(value string) string {
	if len(value) > 8 {
		return value[:8]
	}
	return value
}
func planningPreferenceLabel(value float64) string {
	if value >= .95 {
		return "vollständig erfüllt"
	}
	if value >= .65 {
		return "kein enger Zeitraum hinterlegt"
	}
	return "außerhalb des Wunschzeitraums"
}
func planningPreferenceClass(value float64) string {
	if value >= .95 {
		return "good"
	}
	if value >= .65 {
		return "neutral"
	}
	return "warning"
}
func planningRegions(values []planning.RouteCandidate) []string {
	unique := map[string]struct{}{}
	for _, item := range values {
		if strings.TrimSpace(item.Region) != "" {
			unique[item.Region] = struct{}{}
		}
	}
	result := make([]string, 0, len(unique))
	for value := range unique {
		result = append(result, value)
	}
	sort.Strings(result)
	return result
}
func planningContainsJob(values []planning.RouteCandidate, missing []planning.RouteMissingLocation, id string) bool {
	for _, item := range values {
		if item.JobID == id {
			return true
		}
	}
	for _, item := range missing {
		if item.JobID == id {
			return true
		}
	}
	return false
}
