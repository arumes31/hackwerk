package templates

import "strings"

type LoginData struct {
	Page     PageData
	Username string
	Error    string
	Notice   string
}

func loginBuildVersion(displayVersion string) string {
	version, _, _ := strings.Cut(strings.TrimSpace(displayVersion), " · ")
	if version == "" {
		return "dev"
	}
	return version
}

func loginBuildID(displayVersion string) string {
	_, commit, found := strings.Cut(strings.TrimSpace(displayVersion), " · ")
	if !found || strings.TrimSpace(commit) == "" {
		return "local"
	}
	return strings.TrimSpace(commit)
}

templ Login(data LoginData) {
	<!DOCTYPE html>
	<html lang="de-AT">
		@documentHeadWithStyle(data.Page, "Anmelden – "+data.Page.AppName, data.Page.LoginCSSPath)
		<body class="login-body">
			<div class="connectivity-banner" role="status" aria-live="polite" data-connectivity-banner hidden></div>
			<a class="skip-link" href="#hauptinhalt">Zum Anmeldeformular springen</a>
			<main id="hauptinhalt" class="login-page">
				<section class="login-panel" aria-labelledby="login-heading">
					<header class="login-panel__header">
						<div class="login-emblem" aria-hidden="true">
							<svg viewBox="0 0 24 24" focusable="false">
								<path d="M12 3 8.4 9h2L7.2 14h3.3v4h3v-4h3.3l-3.2-5h2z"></path>
							</svg>
						</div>
						<p class="login-wordmark">{ data.Page.AppName }</p>
						<span class="login-rule" aria-hidden="true"></span>
						<h1 id="login-heading">Anmelden</h1>
						<p class="login-intro">Melden Sie sich an, um auf Ihr Konto zuzugreifen.</p>
					</header>
					if data.Error != "" {
						<div id="login-error" class="login-alert" role="alert" tabindex="-1">{ data.Error }</div>
					}
					if data.Notice != "" {
						<div class="form-alert form-alert--info" role="status">{ data.Notice }</div>
					}
					<form method="post" action="/login" class="login-form">
						<div class="login-field">
							<label for="username">Benutzername</label>
							<input id="username" name="username" value={ data.Username } autocomplete="username" autocapitalize="none" spellcheck="false" placeholder="Einsatz-ID oder Name" required autofocus/>
						</div>
						<div class="login-field">
							<label for="password">Passwort</label>
							<input id="password" name="password" type="password" autocomplete="current-password" placeholder="Passwort eingeben" data-password-input required/>
						</div>
						<button class="login-submit" type="submit">
							<span>Anmelden</span>
							<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
								<path d="M12 3.5a7.5 7.5 0 0 0-7.5 7.5m15 0A7.5 7.5 0 0 0 12 3.5m-4.7 8.1A4.7 4.7 0 0 1 12 6.9a4.7 4.7 0 0 1 4.7 4.7m-7.2 1.1A2.5 2.5 0 0 1 12 10.2a2.5 2.5 0 0 1 2.5 2.5c0 3.5-1 6-2.5 7.8m-5.1-6.9c.2 3.2 1 5.6 2.4 7m7.8-7c-.2 3.2-1 5.6-2.4 7"></path>
							</svg>
						</button>
					</form>
				</section>
			</main>
			<footer class="login-meta" aria-label="Buildinformationen">
				<span>HWK-SYS // V { loginBuildVersion(data.Page.BuildVersion) } · ID: { loginBuildID(data.Page.BuildVersion) }</span>
				<nav aria-label="Rechtliche Informationen">
					<a href="/impressum">Impressum</a>
					<a href="/datenschutz">Datenschutz</a>
					<a href="/cookies">Cookies</a>
					<button type="button" data-privacy-notice-open>Cookie-Hinweis</button>
				</nav>
			</footer>
			@privacyNotice(data.Page)
			<div class="visually-hidden" aria-live="polite" data-live-status></div>
		</body>
	</html>
}
