package templates

templ loginOriginalScene() {
	<section class="scene">
		<svg id="map" viewBox="0 0 1200 800" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
			<defs>
				<linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
					<stop offset="0%" stop-color="#abbf8a"></stop>
					<stop offset="45%" stop-color="#9bb47b"></stop>
					<stop offset="100%" stop-color="#8ba16c"></stop>
				</linearGradient>
				<radialGradient id="hillShade1" cx="30%" cy="30%" r="70%">
					<stop offset="0%" stop-color="#b8ce96" stop-opacity="0.6"></stop>
					<stop offset="100%" stop-color="#809860" stop-opacity="0.4"></stop>
				</radialGradient>
				<pattern id="plowedPattern" width="14" height="14" patternUnits="userSpaceOnUse" patternTransform="rotate(28)">
					<rect width="14" height="14" fill="#cb9f6e"></rect>
					<line x1="0" y1="3.5" x2="14" y2="3.5" stroke="#a97e4f" stroke-width="2.5"></line>
					<line x1="0" y1="10.5" x2="14" y2="10.5" stroke="#a97e4f" stroke-width="2.5"></line>
				</pattern>
				<pattern id="cropPattern" width="12" height="12" patternUnits="userSpaceOnUse" patternTransform="rotate(-18)">
					<rect width="12" height="12" fill="#d1be75"></rect>
					<circle cx="3" cy="3" r="1.8" fill="#a89547"></circle>
					<circle cx="9" cy="9" r="1.8" fill="#a89547"></circle>
				</pattern>
				<pattern id="canolaPattern" width="16" height="16" patternUnits="userSpaceOnUse" patternTransform="rotate(10)">
					<rect width="16" height="16" fill="#e5cd43"></rect>
					<circle cx="4" cy="4" r="2.5" fill="#d3b729"></circle>
					<circle cx="12" cy="12" r="2.5" fill="#d3b729"></circle>
					<circle cx="4" cy="12" r="1.5" fill="#be9f1a"></circle>
					<circle cx="12" cy="4" r="1.5" fill="#be9f1a"></circle>
				</pattern>
				<pattern id="gravelPattern" width="10" height="10" patternUnits="userSpaceOnUse">
					<rect width="10" height="10" fill="#b1aa9b"></rect>
					<circle cx="2" cy="3" r="1" fill="#888172"></circle>
					<circle cx="7" cy="6" r="1.2" fill="#938c7f"></circle>
					<circle cx="4" cy="8" r="0.8" fill="#756f62"></circle>
				</pattern>
				<pattern id="asphaltPattern" width="12" height="12" patternUnits="userSpaceOnUse">
					<rect width="12" height="12" fill="#58615a"></rect>
					<circle cx="3" cy="3" r="0.8" fill="#3f4640"></circle>
					<circle cx="9" cy="8" r="0.8" fill="#727c74"></circle>
				</pattern>
				<pattern id="solarPattern" width="8" height="6" patternUnits="userSpaceOnUse">
					<rect width="8" height="6" fill="#1b3854" stroke="#48729b" stroke-width="0.5"></rect>
				</pattern>
				<linearGradient id="roofHqGrad" x1="0%" y1="0%" x2="0%" y2="100%">
					<stop offset="0%" stop-color="#bd5135"></stop>
					<stop offset="100%" stop-color="#832f1b"></stop>
				</linearGradient>
				<linearGradient id="roofDepotGrad" x1="0%" y1="0%" x2="0%" y2="100%">
					<stop offset="0%" stop-color="#5a6860"></stop>
					<stop offset="100%" stop-color="#3b443f"></stop>
				</linearGradient>
				<linearGradient id="roofMachineGrad" x1="0%" y1="0%" x2="0%" y2="100%">
					<stop offset="0%" stop-color="#6f844a"></stop>
					<stop offset="100%" stop-color="#46552d"></stop>
				</linearGradient>
				<radialGradient id="headlightGrad" cx="0%" cy="50%" r="100%">
					<stop offset="0%" stop-color="#fff8bd" stop-opacity="0.9"></stop>
					<stop offset="45%" stop-color="#ffe670" stop-opacity="0.4"></stop>
					<stop offset="100%" stop-color="#ffe670" stop-opacity="0"></stop>
				</radialGradient>
				<!-- Modern Gradient Artwork Set -->
				<radialGradient id="sunGlow" cx="18%" cy="12%" r="75%">
					<stop offset="0%" stop-color="#fff6d8" stop-opacity="0.35"></stop>
					<stop offset="60%" stop-color="#fff6d8" stop-opacity="0.08"></stop>
					<stop offset="100%" stop-color="#fff6d8" stop-opacity="0"></stop>
				</radialGradient>
				<linearGradient id="forestGrad" x1="0" y1="0" x2="0" y2="1">
					<stop offset="0%" stop-color="#4e7f41"></stop>
					<stop offset="100%" stop-color="#2f5429"></stop>
				</linearGradient>
				<linearGradient id="waterGrad" gradientUnits="userSpaceOnUse" x1="0" y1="480" x2="1200" y2="560">
					<stop offset="0%" stop-color="#3a90b4"></stop>
					<stop offset="50%" stop-color="#4faccb"></stop>
					<stop offset="100%" stop-color="#3585a8"></stop>
				</linearGradient>
				<linearGradient id="pineGradDark" x1="0" y1="0" x2="0" y2="1">
					<stop offset="0%" stop-color="#2f6b4e"></stop>
					<stop offset="100%" stop-color="#1b4532"></stop>
				</linearGradient>
				<linearGradient id="pineGradLight" x1="0" y1="0" x2="0" y2="1">
					<stop offset="0%" stop-color="#4a9468"></stop>
					<stop offset="100%" stop-color="#2c6a4b"></stop>
				</linearGradient>
				<linearGradient id="leafGrad" x1="0" y1="0" x2="0" y2="1">
					<stop offset="0%" stop-color="#55a06b"></stop>
					<stop offset="100%" stop-color="#2e6b47"></stop>
				</linearGradient>
				<linearGradient id="cabGrad" x1="0" y1="0" x2="0" y2="1">
					<stop offset="0%" stop-color="#35805c"></stop>
					<stop offset="100%" stop-color="#1d4a35"></stop>
				</linearGradient>
				<linearGradient id="vanGrad" x1="0" y1="0" x2="0" y2="1">
					<stop offset="0%" stop-color="#eab044"></stop>
					<stop offset="100%" stop-color="#c07f24"></stop>
				</linearGradient>
				<linearGradient id="bedGrad" x1="0" y1="0" x2="0" y2="1">
					<stop offset="0%" stop-color="#b05840"></stop>
					<stop offset="100%" stop-color="#8a3d2a"></stop>
				</linearGradient>
			</defs>
			<!-- Ground Base & Topographic Elevations -->
			<rect class="terrain" width="1200" height="800"></rect>
			<path fill="url(#hillShade1)" d="M-50 120 C150 40 380 90 520 20 C700 -20 880 30 1050 10 C1150 0 1250 40 1250 180 L1250 -50 L-50 -50 Z"></path>
			<path fill="url(#hillShade1)" d="M-50 650 C200 580 420 620 650 590 C850 560 1080 630 1250 600 L1250 850 L-50 850 Z" opacity="0.6"></path>
			<rect width="1200" height="800" fill="url(#sunGlow)" pointer-events="none"></rect>
			<!-- Contour Topography Lines -->
			<path class="contour" d="M0 190 C180 160 380 200 560 170 C740 140 940 180 1200 150"></path>
			<path class="contour" d="M0 230 C200 195 400 235 580 200 C760 165 960 215 1200 180"></path>
			<path class="contour" d="M0 610 C220 575 440 615 660 580 C880 545 1060 595 1200 560"></path>
			<!-- Organic Curved Fields -->
			<path class="field-plowed" d="M-10 -10 L 290 -10 C 285 70 270 125 245 185 C 160 180 80 190 -10 175 Z"></path>
			<path class="field-canola" d="M 290 -10 L 530 -10 C 535 60 520 115 500 160 C 410 155 330 165 245 185 C 270 125 285 70 290 -10 Z"></path>
			<path class="field-crop" d="M 530 -10 L 780 -10 C 785 65 770 120 745 168 C 660 160 580 170 500 160 C 520 115 535 60 530 -10 Z"></path>
			<path class="field-pasture" d="M 780 -10 L 1000 -10 C 1005 70 990 125 965 178 C 880 170 810 175 745 168 C 770 120 785 65 780 -10 Z"></path>
			<path class="field-meadow" d="M 1000 -10 L 1210 -10 L 1210 195 C 1110 190 1030 195 965 178 C 990 125 1005 70 1000 -10 Z"></path>
			<path class="field-meadow" d="M -10 615 C 80 620 160 610 240 625 C 235 690 220 750 210 810 L -10 810 Z"></path>
			<path class="field-crop" d="M 240 625 C 320 615 400 625 460 635 C 455 700 440 750 435 810 L 210 810 C 220 750 235 690 240 625 Z"></path>
			<path class="field-plowed" d="M 460 635 C 540 625 620 630 680 645 C 675 705 660 755 655 810 L 435 810 C 440 750 455 700 460 635 Z"></path>
			<path class="field-canola" d="M 680 645 C 760 635 840 630 915 635 C 910 700 895 755 890 810 L 655 810 C 660 755 675 705 680 645 Z"></path>
			<path class="field-pasture" d="M 915 635 C 1010 630 1100 625 1210 610 L 1210 810 L 890 810 C 895 755 910 700 915 635 Z"></path>
			<!-- Hay Bales Scatter -->
			<g class="hay-bales">
				<ellipse cx="610" cy="70" rx="7" ry="4.5" fill="#e0c763" stroke="#938133" stroke-width="1"></ellipse>
				<ellipse cx="675" cy="115" rx="7" ry="4.5" fill="#e0c763" stroke="#938133" stroke-width="1"></ellipse>
				<ellipse cx="730" cy="50" rx="7" ry="4.5" fill="#e0c763" stroke="#938133" stroke-width="1"></ellipse>
				<ellipse cx="295" cy="700" rx="7" ry="4.5" fill="#e0c763" stroke="#938133" stroke-width="1"></ellipse>
				<ellipse cx="370" cy="745" rx="7" ry="4.5" fill="#e0c763" stroke="#938133" stroke-width="1"></ellipse>
			</g>
			<!-- Bushes & Rocks Decoration -->
			<g class="nature-deco">
				<circle class="bush" cx="255" cy="205" r="6"></circle><circle class="bush" cx="268" cy="210" r="4.5"></circle>
				<circle class="bush" cx="640" cy="185" r="5.5"></circle><circle class="bush" cx="652" cy="190" r="4"></circle>
				<circle class="bush" cx="1010" cy="210" r="6"></circle><circle class="bush" cx="1022" cy="215" r="4.5"></circle>
				<circle class="bush" cx="180" cy="440" r="6"></circle><circle class="bush" cx="192" cy="446" r="4"></circle>
				<circle class="bush" cx="1060" cy="430" r="5.5"></circle><circle class="bush" cx="1072" cy="436" r="4"></circle>
				<circle class="bush" cx="480" cy="585" r="5"></circle><circle class="bush" cx="760" cy="585" r="5.5"></circle>
				<ellipse class="rock" cx="350" cy="215" rx="5" ry="3.4"></ellipse>
				<ellipse class="rock" cx="880" cy="200" rx="4.4" ry="3"></ellipse>
				<ellipse class="rock" cx="560" cy="600" rx="5" ry="3.2"></ellipse>
			</g>
			<!-- Green Hedges Boundary -->
			<path class="hedge" d="M-10 185C130 178 240 195 330 182M750 185C890 172 1025 195 1210 176M-10 605C150 595 290 612 430 598M750 605C890 590 1030 610 1210 596"></path>
			<!-- Realistic Winding Waterway -->
			<path class="water-bed" d="M-20 520 C 130 470, 245 565, 365 520 S 580 470, 720 515 S 945 575, 1220 505"></path>
			<path class="water-bank" d="M-20 520 C 130 470, 245 565, 365 520 S 580 470, 720 515 S 945 575, 1220 505"></path>
			<path class="water-bg" d="M-20 520 C 130 470, 245 565, 365 520 S 580 470, 720 515 S 945 575, 1220 505"></path>
			<path class="water-flow" d="M-20 520 C 130 470, 245 565, 365 520 S 580 470, 720 515 S 945 575, 1220 505"></path>
			<!-- Reeds along the riverbank -->
			<g class="reeds">
				<path class="reed" d="M150 492 l-3 -12 M155 493 l1 -13 M160 494 l4 -11"></path>
				<path class="reed" d="M430 500 l-3 -12 M435 501 l1 -13 M440 502 l4 -11"></path>
				<path class="reed" d="M700 498 l-3 -12 M705 499 l1 -13 M710 500 l4 -11"></path>
				<path class="reed" d="M960 556 l-3 -12 M965 557 l1 -13 M970 558 l4 -11"></path>
			</g>
			<!-- Sandbars & Water Lilies -->
			<path d="M 330 535 C 350 538, 370 530, 380 522 C 360 525, 340 530, 330 535 Z" fill="#d3bf8f" opacity="0.85"></path>
			<g class="water-lilies">
				<circle cx="175" cy="495" r="3.2" fill="#2d5e35"></circle><circle cx="180" cy="498" r="2.5" fill="#2d5e35"></circle>
				<circle cx="515" cy="505" r="3.5" fill="#2d5e35"></circle><circle cx="521" cy="503" r="2.5" fill="#2d5e35"></circle>
				<circle cx="865" cy="552" r="3.5" fill="#2d5e35"></circle><circle cx="871" cy="554" r="2" fill="#2d5e35"></circle>
			</g>
			<!-- Detailed Village Settlements -->
			<g class="settlements">
				<!-- Village West: "Sankt Hubertus" -->
				<g id="villageSanktHubertus">
					<path class="village-zone" d="M 440 240 C 470 230, 570 235, 585 270 C 600 310, 580 355, 540 365 C 470 375, 430 330, 440 240 Z"></path>
					<rect class="plaza" x="490" y="275" width="45" height="35" rx="4"></rect>
					<g transform="translate(500, 270)">
						<rect class="church-body" x="-12" y="-10" width="24" height="22" rx="2"></rect>
						<path class="church-roof" d="M-14 -10 L0 -24 L14 -10 Z"></path>
						<rect class="church-body" x="-6" y="-28" width="12" height="20"></rect>
						<path class="spire" d="M-7 -28 L0 -48 L7 -28 Z"></path>
						<circle cx="0" cy="-20" r="3" fill="#fff" stroke="#444" stroke-width="0.8"></circle>
					</g>
					<g transform="translate(455, 255)"><rect class="house" x="-10" y="-8" width="20" height="16" rx="1"></rect><path class="roof-clay" d="M-12 -8 L0 -17 L12 -8 Z"></path></g>
					<g transform="translate(550, 250)"><rect class="house" x="-11" y="-9" width="22" height="18" rx="1"></rect><path class="roof-clay" d="M-13 -9 L0 -19 L13 -9 Z"></path></g>
					<g transform="translate(460, 310)"><rect class="house" x="-12" y="-8" width="24" height="16" rx="1"></rect><path class="roof-slate" d="M-14 -8 L0 -17 L14 -8 Z"></path></g>
					<g transform="translate(555, 320)"><rect class="house" x="-10" y="-8" width="20" height="16" rx="1"></rect><path class="roof-thatch" d="M-12 -8 L0 -17 L12 -8 Z"></path></g>
					<g transform="translate(500, 335)"><rect class="house" x="-11" y="-8" width="22" height="16" rx="1"></rect><path class="roof-clay" d="M-13 -8 L0 -17 L13 -8 Z"></path></g>
				</g>
				<!-- Village East: "Oberforst" -->
				<g id="villageOberforst">
					<path class="village-zone" d="M 825 225 C 870 215, 960 220, 970 260 C 980 300, 950 335, 900 340 C 840 345, 815 300, 825 225 Z"></path>
					<g transform="translate(850, 245)"><rect class="house" x="-14" y="-9" width="28" height="18" rx="1"></rect><path class="roof-clay" d="M-16 -9 L0 -20 L16 -9 Z"></path></g>
					<g transform="translate(905, 240)"><rect class="house" x="-12" y="-8" width="24" height="16" rx="1"></rect><path class="roof-slate" d="M-14 -8 L0 -17 L14 -8 Z"></path></g>
					<g transform="translate(945, 275)"><rect class="house" x="-10" y="-8" width="20" height="16" rx="1"></rect><path class="roof-thatch" d="M-12 -8 L0 -17 L12 -8 Z"></path></g>
					<g transform="translate(860, 295)"><rect class="house" x="-13" y="-9" width="26" height="18" rx="1"></rect><path class="roof-clay" d="M-15 -9 L0 -19 L15 -9 Z"></path></g>
					<g transform="translate(910, 305)"><rect class="house" x="-11" y="-8" width="22" height="16" rx="1"></rect><path class="roof-slate" d="M-13 -8 L0 -17 L13 -8 Z"></path></g>
				</g>
			</g>
			<!-- Forest Polygons Base Layer -->
			<g id="forestPolys">
				<path id="forest0" class="forest" d="M40 50L155 30 205 90 180 185 70 176 22 115Z"></path>
				<path id="forest1" class="forest" d="M250 42L355 38 410 96 374 182 274 175 228 105Z"></path>
				<path id="forest2" class="forest" d="M450 38L545 44 585 108 550 192 465 180 428 102Z"></path>
				<path id="forest3" class="forest" d="M670 38L775 34 820 100 782 188 695 181 650 108Z"></path>
				<path id="forest4" class="forest" d="M855 42L960 34 1012 98 974 188 883 179 837 108Z"></path>
				<path id="forest5" class="forest" d="M1025 42L1142 54 1185 120 1148 202 1048 190 1005 110Z"></path>
				<path id="forest6" class="forest" d="M32 620L132 582 190 645 157 770 53 762 12 688Z"></path>
				<path id="forest7" class="forest" d="M240 624L342 588 400 650 362 772 262 762 220 689Z"></path>
				<path id="forest8" class="forest" d="M448 630L538 588 580 650 548 772 468 762 430 695Z"></path>
				<path id="forest9" class="forest" d="M675 624L772 588 830 650 798 772 704 762 657 692Z"></path>
				<path id="forest10" class="forest" d="M865 618L962 582 1020 645 988 768 892 762 846 690Z"></path>
				<path id="forest11" class="forest" d="M1035 603L1142 578 1194 645 1163 768 1058 762 1014 686Z"></path>
			</g>
			<!-- Renewable Energy & Infrastructure Assets -->
			<g class="wind-turbines">
				<g transform="translate(110, 290)">
					<ellipse cx="0" cy="18" rx="10" ry="3" fill="rgba(0,0,0,0.15)"></ellipse>
					<path d="M-2 18 L-1 -25 L1 -25 L2 18 Z" fill="#e3e8e5"></path>
					<circle cx="0" cy="-25" r="3" fill="#cfd6d2"></circle>
					<g transform="translate(0, -25)">
						<g class="wind-blade wind-blade--west">
							<circle cx="0" cy="0" r="32" fill="none"></circle>
							<path d="M0 0 L2 -32 L-2 -32 Z" fill="#ffffff" stroke="#cbd5e1" stroke-width="0.5"></path>
							<path d="M0 0 L28 14 L25 18 Z" fill="#ffffff" stroke="#cbd5e1" stroke-width="0.5"></path>
							<path d="M0 0 L-28 14 L-25 18 Z" fill="#ffffff" stroke="#cbd5e1" stroke-width="0.5"></path>
							<circle cx="0" cy="0" r="2.5" fill="#cfd6d2"></circle>
						</g>
					</g>
				</g>
				<g transform="translate(1105, 290)">
					<ellipse cx="0" cy="18" rx="10" ry="3" fill="rgba(0,0,0,0.15)"></ellipse>
					<path d="M-2 18 L-1 -25 L1 -25 L2 18 Z" fill="#e3e8e5"></path>
					<circle cx="0" cy="-25" r="3" fill="#cfd6d2"></circle>
					<g transform="translate(0, -25)">
						<g class="wind-blade wind-blade--east">
							<circle cx="0" cy="0" r="32" fill="none"></circle>
							<path d="M0 0 L2 -32 L-2 -32 Z" fill="#ffffff" stroke="#cbd5e1" stroke-width="0.5"></path>
							<path d="M0 0 L28 14 L25 18 Z" fill="#ffffff" stroke="#cbd5e1" stroke-width="0.5"></path>
							<path d="M0 0 L-28 14 L-25 18 Z" fill="#ffffff" stroke="#cbd5e1" stroke-width="0.5"></path>
							<circle cx="0" cy="0" r="2.5" fill="#cfd6d2"></circle>
						</g>
					</g>
				</g>
			</g>
			<!-- Dynamic Road Layers -->
			<g id="roads"></g>
			<!-- River Bridges over Road Crossings -->
			<g class="bridges">
				<g transform="translate(365, 520) rotate(-15)">
					<rect class="bridge-pier" x="-18" y="-14" width="36" height="28" rx="3"></rect>
					<rect class="bridge-structure" x="-15" y="-12" width="30" height="24" rx="2"></rect>
					<line class="bridge-rail" x1="-15" y1="-11" x2="15" y2="-11"></line>
					<line class="bridge-rail" x1="-15" y1="11" x2="15" y2="11"></line>
				</g>
				<g transform="translate(607, 500) rotate(82)">
					<rect class="bridge-pier" x="-18" y="-14" width="36" height="28" rx="3"></rect>
					<rect class="bridge-structure" x="-15" y="-12" width="30" height="24" rx="2"></rect>
					<line class="bridge-rail" x1="-15" y1="-11" x2="15" y2="-11"></line>
					<line class="bridge-rail" x1="-15" y1="11" x2="15" y2="11"></line>
				</g>
				<g transform="translate(720, 515) rotate(12)">
					<rect class="bridge-pier" x="-18" y="-14" width="36" height="28" rx="3"></rect>
					<rect class="bridge-structure" x="-15" y="-12" width="30" height="24" rx="2"></rect>
					<line class="bridge-rail" x1="-15" y1="-11" x2="15" y2="-11"></line>
					<line class="bridge-rail" x1="-15" y1="11" x2="15" y2="11"></line>
				</g>
			</g>
			<!-- Dynamic Vector Building Complexes & Hub Pads -->
			<g id="hubPads">
				<g transform="translate(595, 425)">
					<rect class="asphalt-pad" x="-75" y="-35" width="150" height="70" rx="8"></rect>
					<line class="parking-space" x1="-65" y1="15" x2="-65" y2="30"></line>
					<line class="parking-space" x1="-50" y1="15" x2="-50" y2="30"></line>
					<line class="parking-space" x1="-35" y1="15" x2="-35" y2="30"></line>
					<rect class="parked-car" x="-62" y="18" width="9" height="10"></rect>
					<rect class="parked-car" x="-47" y="18" width="9" height="10" fill="#a44c37"></rect>
				</g>
				<g transform="translate(690, 425)">
					<rect class="yard-pad" x="-50" y="-30" width="100" height="60" rx="6"></rect>
					<circle cx="35" cy="-15" r="7" fill="#727d75" stroke="#444" stroke-width="1"></circle>
					<circle cx="35" cy="-15" r="5" fill="#a2b0a6"></circle>
					<line x1="25" y1="-5" x2="45" y2="-5" stroke="#9b4931" stroke-width="2"></line>
				</g>
				<g transform="translate(310, 455)"><rect class="yard-pad" x="-45" y="-28" width="90" height="56" rx="6"></rect></g>
				<g transform="translate(900, 430)"><rect class="yard-pad" x="-45" y="-28" width="90" height="56" rx="6"></rect></g>
				<g transform="translate(610, 630)"><rect class="yard-pad" x="-45" y="-28" width="90" height="56" rx="6"></rect></g>
			</g>
			<g id="buildings"></g>
			<g id="forestDynamic"></g>
			<g id="logs"></g>
			<g id="piles"></g>
			<g id="vehicles"></g>
			<g id="fx"></g>
			<!-- Street Lights at Hub Intersections -->
			<g class="street-lights" fill="#ffe270">
				<circle cx="530" cy="460" r="2.5" stroke="#333" stroke-width="0.8"></circle>
				<circle cx="660" cy="460" r="2.5" stroke="#333" stroke-width="0.8"></circle>
			</g>
			<!-- Flying Birds in V-Formation -->
			<g class="bird-flock">
				<g class="bird" transform="translate(0, 0)"><path d="M-6 0 C-3 -4 0 0 0 0 C0 0 3 -4 6 0" fill="none" stroke="#22331f" stroke-width="1.8"></path></g>
				<g class="bird" transform="translate(18, 10)"><path d="M-6 0 C-3 -4 0 0 0 0 C0 0 3 -4 6 0" fill="none" stroke="#22331f" stroke-width="1.8"></path></g>
				<g class="bird" transform="translate(14, -12)"><path d="M-6 0 C-3 -4 0 0 0 0 C0 0 3 -4 6 0" fill="none" stroke="#22331f" stroke-width="1.8"></path></g>
				<g class="bird" transform="translate(36, 22)"><path d="M-6 0 C-3 -4 0 0 0 0 C0 0 3 -4 6 0" fill="none" stroke="#22331f" stroke-width="1.8"></path></g>
				<g class="bird" transform="translate(32, -24)"><path d="M-6 0 C-3 -4 0 0 0 0 C0 0 3 -4 6 0" fill="none" stroke="#22331f" stroke-width="1.8"></path></g>
			</g>
			<!-- Floating Ambient Clouds -->
			<g class="cloud-group cloud-group--near">
				<path d="M20 30 Q30 15 45 25 Q55 10 70 20 Q85 15 95 30 Q105 40 90 50 Q75 55 50 50 Q25 55 15 45 Q5 35 20 30 Z" fill="rgba(255,255,255,0.45)"></path>
			</g>
			<g class="cloud-group cloud-group--far">
				<path d="M30 40 Q45 20 65 32 Q80 15 100 28 Q120 20 135 40 Q150 55 130 70 Q105 75 70 70 Q35 75 20 60 Q5 50 30 40 Z" fill="rgba(255,255,255,0.35)"></path>
			</g>
		</svg>
		<div class="shade"></div>
	</section>
}
