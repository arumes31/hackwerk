package templates

import "strconv"

// RouteLocationsSettingsData is supplied by the settings handler. Locations
// contains active and inactive records. Only active locations are offered in
// the route planner; inactive ones remain read-only history here.
type RouteLocationsSettingsData struct {
	Shell          ShellData
	Locations      []RouteLocationOption
	DefaultStartID string
	DefaultEndID   string
	Error          string
}

templ RouteLocationsSettings(data RouteLocationsSettingsData) {
	<!DOCTYPE html>
	<html lang="de-AT">
		@documentHead(data.Shell.Page, "Routenorte – "+data.Shell.Page.AppName)
		<body>
			@appHeader(data.Shell)
			<main id="hauptinhalt" class="page route-page compact-page route-location-page">
				<div class="page-heading">
					<div><p class="eyebrow">Einstellungen</p><h1>Routenorte</h1><p>Start und Ende werden aus klar benannten, geprüften Orten gewählt. Standards sind nur Vorauswahlen.</p></div>
					<a class="button button--quiet" href="/planning/routes">Routenplanung öffnen</a>
				</div>
				if data.Error != "" {
					<div class="form-alert" role="alert">{ data.Error }</div>
				}
				<section class="route-location-settings" aria-label="Routenorte verwalten">
					<form method="post" action="/settings/route-locations" class="form-card route-location-settings__form" data-route-location-editor>
						<input type="hidden" name="csrf_token" value={ data.Shell.CSRFToken }/>
						<input type="hidden" name="confirmed" value="" data-route-location-confirmed/>
						@mapAssetData(data.Shell.Page)
						<div class="section-heading"><div><p class="eyebrow">Neuer Ort</p><h2>Ort prüfen und speichern</h2></div></div>
						<div class="route-location-create-grid">
							<div class="route-location-form-fields">
								<label>Bezeichnung<input type="text" name="name" maxlength="120" autocomplete="off" placeholder="z. B. Lagerplatz Nord" data-route-location-label required/></label>
								<label>Geprüfte Adresse<input type="text" name="address" maxlength="500" autocomplete="street-address" placeholder="Straße, Ort" data-route-location-address required/></label>
								<div class="location-search">
									<label for="route-location-address-search">Adresse suchen</label>
									<div class="location-search__bar"><input id="route-location-address-search" type="search" maxlength="200" autocomplete="off" placeholder="z. B. Waldstraße 9, Unterneukirchen" data-route-location-search-input/><button class="button button--quiet" type="button" data-route-location-search-submit>Adresse suchen</button></div>
									<p class="form-hint location-search__status" data-route-location-search-status aria-live="polite"></p>
									<ul class="location-search__results" data-route-location-search-results aria-label="Gefundene Adressen" hidden></ul>
								</div>
								<div class="coordinate-grid">
									<label>Breitengrad<input type="text" name="latitude" inputmode="decimal" autocomplete="off" placeholder="48,208000" data-route-location-latitude required/></label>
									<label>Längengrad<input type="text" name="longitude" inputmode="decimal" autocomplete="off" placeholder="16,373000" data-route-location-longitude required/></label>
								</div>
								<div class="route-location-defaults__choices"><label class="check-label"><input type="checkbox" name="default_start" value="true"/>Als Standard-Start verwenden</label><label class="check-label"><input type="checkbox" name="default_end" value="true"/>Als Standard-Ende verwenden</label></div>
								<label class="check-label route-location-native-confirm"><input type="checkbox" name="confirmed_native" value="true" data-route-location-native-confirmed/> Adresse und Koordinaten geprüft</label>
								<div class="route-location-editor-actions"><button class="button button--quiet" type="button" data-route-location-confirm>Standort übernehmen</button><button class="button" type="submit">Ort speichern</button></div>
								<span class="form-hint" data-route-location-message aria-live="polite">Adresse oder Koordinaten prüfen und anschließend übernehmen.</span>
								<p class="form-alert route-location-picker__error" data-route-location-error role="alert" hidden></p>
							</div>
							<section class="route-location-map-panel" aria-labelledby="route-location-map-title">
								<div class="section-heading"><div><p class="eyebrow">Kartenwahl</p><h3 id="route-location-map-title">Position anklicken</h3></div><span class="status-badge">Entwurf</span></div>
								<p class="form-hint" id="route-location-map-hint">Klicken Sie auf die tatsächliche Position oder ziehen Sie den Marker. Die geprüfte Adresse bleibt separat erforderlich.</p>
								<div class="job-location-map route-location-map" data-route-location-map aria-labelledby="route-location-map-title" aria-describedby="route-location-map-hint"><div class="map-fallback" data-map-fallback>Die Straßenkarte wird geladen. Koordinaten können weiterhin direkt eingegeben werden.</div></div>
							</section>
						</div>
					</form>
					<div class="route-location-list">
						<div class="section-heading"><div><p class="eyebrow">Gespeicherte Orte</p><h2>{ strconv.Itoa(len(data.Locations)) } Orte</h2></div></div>
						if len(data.Locations) == 0 {
							<div class="empty-state"><h2>Noch kein Routenort</h2><p>Legen Sie zuerst mindestens einen geprüften Ort an. Ohne Standard bleibt die individuelle Auswahl in der Routenplanung verfügbar.</p></div>
						}
						for _, location := range data.Locations {
							<details class="route-location-card">
								<summary class="route-location-card__summary">
									<span><strong>{ location.Name }</strong><small>{ location.Address }</small></span>
									<span class="route-location-card__badges">
										if location.DefaultStart {
											<span class="status-badge">Standard-Start</span>
										}
										if location.DefaultEnd {
											<span class="status-badge">Standard-Ende</span>
										}
										if !location.Active {
											<span class="status-badge">Deaktiviert</span>
										}
									</span>
								</summary>
								if !location.Active {
									<div class="route-location-card__body"><div class="route-location-card__facts"><span>{ location.Latitude }, { location.Longitude }</span><span>Nur noch in der Historie sichtbar</span></div></div>
								} else {
									<form method="post" action={ "/settings/route-locations/" + location.ID } class="form-grid" data-route-location-editor>
										<input type="hidden" name="csrf_token" value={ data.Shell.CSRFToken }/>
										<input type="hidden" name="version" value={ strconv.Itoa(int(location.Version)) }/>
										<input type="hidden" name="confirmed" value="true" data-route-location-confirmed/>
										<label>Bezeichnung<input type="text" name="name" maxlength="120" value={ location.Name } data-route-location-label required/></label>
										<label>Adresse<input type="text" name="address" maxlength="500" value={ location.Address } data-route-location-address required/></label>
										<label>Breitengrad<input type="text" name="latitude" inputmode="decimal" value={ location.Latitude } data-route-location-latitude required/></label>
										<label>Längengrad<input type="text" name="longitude" inputmode="decimal" value={ location.Longitude } data-route-location-longitude required/></label>
										<label class="check-label"><input type="checkbox" name="default_start" value="true" checked?={ location.DefaultStart }/>Standard-Start</label>
										<label class="check-label"><input type="checkbox" name="default_end" value="true" checked?={ location.DefaultEnd }/>Standard-Ende</label>
										<label class="check-label route-location-native-confirm"><input type="checkbox" name="confirmed_native" value="true" data-route-location-native-confirmed checked/> Adresse und Koordinaten geprüft</label>
										<div class="route-location-custom__confirm"><button class="button button--quiet" type="button" data-route-location-confirm>Geänderten Standort übernehmen</button><span class="form-hint" data-route-location-message aria-live="polite">Gespeicherter Standort ist bestätigt.</span></div>
										<p class="form-alert route-location-picker__error" data-route-location-error role="alert" hidden></p>
										<button class="button" type="submit">Speichern</button>
									</form>
									<form method="post" action={ "/settings/route-locations/" + location.ID + "/deactivate" } class="route-location-card__actions">
										<input type="hidden" name="csrf_token" value={ data.Shell.CSRFToken }/>
										<input type="hidden" name="version" value={ strconv.Itoa(int(location.Version)) }/>
										if location.DefaultStart || location.DefaultEnd {
											<label class="check-label"><input type="checkbox" name="confirm_without_default" value="true" required/>Ohne diesen Standard fortfahren</label>
										}
										<button class="button button--quiet" type="submit" data-confirm-message={ location.Name + " deaktivieren? Der Ort wird aus neuen Routenwahlen entfernt. Bestehende Historie bleibt erhalten; Start- oder Endstandards werden aufgehoben." }>Deaktivieren</button>
									</form>
								}
							</details>
						}
					</div>
				</section>
			</main>
			@appFooter(data.Shell.Page)
			<script type="module" src={ data.Shell.Page.RouteLocationsJSPath } defer></script>
		</body>
	</html>
}
