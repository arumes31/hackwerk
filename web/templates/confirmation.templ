package templates

import (
	"example.invalid/hackplan/internal/notification"
	"time"
)

type ConfirmationData struct {
	Page              PageData
	Token             string
	Value             notification.Confirmation
	Invalid           bool
	Retryable         bool
	AlreadyStored     bool
	CallbackStored    bool
	Result            string
	ResponseNote      string
	ResponseNoteError string
}

templ ConfirmationPage(data ConfirmationData) {
	<!DOCTYPE html>
	<html lang="de-AT">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="robots" content="noindex,nofollow,noarchive"/>
			<title>Terminantwort – { data.Page.AppName }</title>
			<link rel="stylesheet" href={ data.Page.CSSPath }/>
			<script type="module" src={ data.Page.JSPath } defer></script>
		</head>
		<body>
			<main class="page confirmation-page">
				<section class="confirmation-card" aria-labelledby="confirmation-title" data-confirmation-card>
					<p class="eyebrow">{ data.Page.Legal.OperatorName }</p>
					<address class="confirmation-contact">
						<strong>{ data.Page.Legal.OperatorName }</strong>
						if customerPhoneURL(data.Page.Legal.Phone) != "" {
							<span>· </span><a href={ customerPhoneURL(data.Page.Legal.Phone) }>{ data.Page.Legal.Phone }</a>
						}
						if data.Page.Legal.Email != "" {
							<span>· </span><a href={ "mailto:" + data.Page.Legal.Email }>{ data.Page.Legal.Email }</a>
						}
					</address>
					if data.Invalid {
						<h1 id="confirmation-title">Link nicht verfügbar</h1>
						<p>Dieser Bestätigungslink ist nicht mehr gültig. Bitte kontaktieren Sie den Betrieb, wenn Sie Ihren Termin abstimmen möchten.</p>
					} else if data.Retryable {
						<h1 id="confirmation-title">Rückmeldung derzeit nicht möglich</h1>
						<p>Die Rückmeldung konnte gerade nicht verarbeitet werden. Bitte öffnen Sie die Terminseite erneut und versuchen Sie es noch einmal.</p>
						<a class="button" href={ "/termin/" + data.Token }>Termin erneut öffnen</a>
					} else if data.AlreadyStored {
						<h1 id="confirmation-title">Antwort bereits gespeichert</h1>
						if data.Result != "" {
							<p>{ data.Result }</p>
						} else {
							<p>Für diesen Link wurde bereits eine Rückmeldung gespeichert. Bitte kontaktieren Sie den Betrieb, wenn Sie Ihre Antwort abstimmen möchten.</p>
						}
						<p>Der Betrieb sieht die gespeicherte Rückmeldung unmittelbar in der Terminplanung.</p>
					} else if data.Result != "" {
						<h1 id="confirmation-title">Antwort gespeichert</h1>
						<p>{ data.Result }</p>
						<p>Danke. Der Betrieb sieht Ihre Rückmeldung unmittelbar in der Terminplanung.</p>
						<button class="button button--quiet" type="button" data-print-page>Bestätigung drucken</button>
					} else {
						<h1 id="confirmation-title">Ihr Termin</h1>
						if data.CallbackStored {
							<p role="status">Ihr Rückrufwunsch ist gespeichert. Sie können den Termin weiterhin direkt bestätigen oder ablehnen.</p>
						}
						<p>Guten Tag { data.Value.CustomerName },</p>
						<dl class="appointment-detail-list">
							<div><dt>Auftrag</dt><dd>{ data.Value.JobNumber }</dd></div>
							<div><dt>Zeit</dt><dd>{ confirmationDateTime(data.Value.StartsAt) }–{ confirmationTime(data.Value.EndsAt) } Uhr</dd></div>
							<div><dt>Zeitzone</dt><dd>Europe/Vienna (österreichische Ortszeit)</dd></div>
							<div><dt>Ort</dt><dd>{ data.Value.Locality }</dd></div>
							<div><dt>Menge</dt><dd>{ data.Value.VolumeM3 } m³</dd></div>
						</dl>
						<p>Bitte wählen Sie genau eine Rückmeldung. Sie können den Termin hier nicht verschieben oder stornieren.</p>
						<form method="post" action={ "/termin/" + data.Token + "/antwort" } class="confirmation-actions" data-confirmation-form>
							<input type="hidden" name="form_nonce" value={ data.Value.FormNonce }/>
							<label for="confirmation-response-note">Optionale Rückrufnotiz</label><textarea id="confirmation-response-note" name="response_note" maxlength="500" rows="3" placeholder="z. B. Bitte vormittags zurückrufen" aria-invalid={ confirmationNoteInvalid(data.ResponseNoteError) } aria-describedby={ confirmationNoteDescription(data.ResponseNoteError) }>{ data.ResponseNote }</textarea><small id="confirmation-note-help">Maximal 500 Zeichen; zusammen mit „Termin ablehnen“ oder „Rückruf wünschen“.</small>
							if data.ResponseNoteError != "" {
								<small id="confirmation-note-error" class="field-error" role="alert">{ data.ResponseNoteError }</small>
							}
							<small id="confirmation-note-feedback" data-confirmation-note-feedback role="status" aria-live="polite">Die Notiz wird nur bei einer Ablehnung oder einem Rückrufwunsch übermittelt.</small>
							<p class="form-hint" data-confirmation-summary>Die gewählte Antwort wird unmittelbar und einmalig gespeichert.</p>
							<button class="button" type="submit" name="action" value="confirmed" data-response-label="Sie bestätigen den angezeigten Termin.">Termin bestätigen</button>
							<button class="button button--quiet" type="submit" name="action" value="declined" data-response-label="Sie lehnen den angezeigten Termin ab.">Termin ablehnen</button>
							if !data.CallbackStored {
								<button class="button button--quiet" type="submit" name="action" value="callback_requested" data-response-label="Sie bitten den Betrieb um einen Rückruf.">Rückruf wünschen</button>
							}
						</form>
					}
				</section>
			</main>
		</body>
	</html>
}

func confirmationDateTime(value time.Time) string {
	local := value.In(viennaLocation())
	weekdays := [...]string{"Sonntag", "Montag", "Dienstag", "Mittwoch", "Donnerstag", "Freitag", "Samstag"}
	return weekdays[local.Weekday()] + ", " + local.Format("02.01.2006 · 15:04")
}
func confirmationTime(value time.Time) string { return value.In(viennaLocation()).Format("15:04") }

func confirmationNoteInvalid(message string) string {
	if message != "" {
		return "true"
	}
	return "false"
}

func confirmationNoteDescription(message string) string {
	if message != "" {
		return "confirmation-note-help confirmation-note-error confirmation-note-feedback"
	}
	return "confirmation-note-help confirmation-note-feedback"
}
