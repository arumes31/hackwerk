package templates

import "fmt"

type PageData struct {
	AppName                     string
	Version                     string
	BuildVersion                string
	CSSPath                     string
	MobileCSSPath               string
	ControlFoundationCSSPath    string
	JSPath                      string
	PresentationBootstrapJSPath string
	RouteLocationsJSPath        string
	ManifestPath                string
	IconPath                    string
	LoginOriginalCSSPath        string
	LoginCSSPath                string
	LoginLoaderJSPath           string
	LoginBackgroundJSPath       string
	MapLibreJSPath              string
	MapLibreWorkerPath          string
	MapLibreCSSPath             string
	MapAttribution              string
	GeocodingEnabled            bool
	FullCalendarJSPath          string
	FullCalendarThemeJSPath     string
	FullCalendarSkeletonCSSPath string
	FullCalendarThemeCSSPath    string
	FullCalendarPaletteCSSPath  string
	Legal                       LegalData
}

templ documentHead(data PageData, title string) {
	@documentHeadWithAssets(data, title, "", "", false)
}

templ calendarDocumentHead(data PageData, title string) {
	@documentHeadWithAssets(data, title, "", "", true)
}

templ documentHeadWithStyle(data PageData, title string, stylePath string) {
	@documentHeadWithAssets(data, title, stylePath, "", false)
}

templ documentHeadWithStyles(data PageData, title string, firstStylePath string, secondStylePath string) {
	@documentHeadWithAssets(data, title, firstStylePath, secondStylePath, false)
}

templ documentHeadWithAssets(data PageData, title string, firstStylePath string, secondStylePath string, includeCalendar bool) {
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
		<meta name="color-scheme" content="light"/>
		<meta name="theme-color" content="#214f3a"/>
		<meta name="application-name" content={ data.AppName }/>
		<meta name="mobile-web-app-capable" content="yes"/>
		<meta name="apple-mobile-web-app-capable" content="yes"/>
		<meta name="apple-mobile-web-app-status-bar-style" content="default"/>
		<title>{ title }</title>
		<link rel="manifest" href={ data.ManifestPath }/>
		<link rel="icon" href={ data.IconPath } type="image/svg+xml"/>
		<link rel="apple-touch-icon" href={ data.IconPath }/>
		<script src={ data.PresentationBootstrapJSPath }></script>
		<link rel="stylesheet" href={ data.ControlFoundationCSSPath }/>
		<link rel="stylesheet" href={ data.CSSPath }/>
		if firstStylePath != "" {
			<link rel="stylesheet" href={ templ.SafeURL(firstStylePath) }/>
		}
		if secondStylePath != "" {
			<link rel="stylesheet" href={ templ.SafeURL(secondStylePath) }/>
		}
		if includeCalendar {
			<link rel="stylesheet" href={ data.FullCalendarSkeletonCSSPath }/>
			<link rel="stylesheet" href={ data.FullCalendarThemeCSSPath }/>
			<link rel="stylesheet" href={ data.FullCalendarPaletteCSSPath }/>
			<script src={ data.FullCalendarJSPath } defer></script>
			<script src={ data.FullCalendarThemeJSPath } defer></script>
		}
		<link rel="stylesheet" href={ data.MobileCSSPath }/>
		<script type="module" src={ data.JSPath } defer></script>
	</head>
}

templ Home(data PageData) {
	<!DOCTYPE html>
	<html lang="de-AT">
		@documentHead(data, data.AppName+" – Einsatzplanung")
		<body>
			<div class="connectivity-banner" role="status" aria-live="polite" data-connectivity-banner hidden></div>
			<a class="skip-link" href="#hauptinhalt">Zum Inhalt springen</a>
			<header class="site-header">
				<div class="site-header__inner">
					<a class="wordmark" href="/" aria-label={ data.AppName + " Startseite" }>
						<span class="wordmark__mark" aria-hidden="true">H</span>
						<span>{ data.AppName }</span>
					</a>
					<span class="build-pill">Version { data.Version }</span>
				</div>
			</header>
			<main id="hauptinhalt" class="page">
				<section class="hero" aria-labelledby="hero-title">
					<div>
						<p class="eyebrow">Planung für Hackeinsätze</p>
						<h1 id="hero-title">Ein klarer Takt für Maschine, Fahrer und Auftrag.</h1>
						<p class="hero__lead">Das technische Fundament läuft. Kunden, Warteliste, Kalender und Benachrichtigungen werden als getrennte, nachvollziehbare Arbeitsbereiche aufgebaut.</p>
					</div>
					<aside class="readiness-card" aria-labelledby="status-title">
						<span class="status-badge status-badge--ready">Webdienst bereit</span>
						<h2 id="status-title">Sicheres Fundament</h2>
						<p>Lokale Assets, kontrolliertes Herunterfahren und getrennte Live-/Datenbankprüfung sind aktiv.</p>
					</aside>
				</section>
				<section class="principles" aria-label="Produktprinzipien">
					<article class="principle">
						<span class="principle__number">01</span>
						<h2>Menschen fixieren Termine</h2>
						<p>Automatik unterstützt. Verbindliche Planung bleibt eine ausdrückliche Adminentscheidung.</p>
					</article>
					<article class="principle">
						<span class="principle__number">02</span>
						<h2>Alle sehen denselben Plan</h2>
						<p>Fahrer erhalten den vollständigen Kalender, unabhängig von der eigenen Zuweisung.</p>
					</article>
					<article class="principle">
						<span class="principle__number">03</span>
						<h2>Mobil ohne Drag-Zwang</h2>
						<p>Jeder Kernfluss erhält eine robuste Touch- und Tastaturalternative.</p>
					</article>
				</section>
			</main>
			@siteFooter(data)
			<div class="visually-hidden" aria-live="polite" data-live-status></div>
		</body>
	</html>
}

templ Error(data PageData, status int, heading string, message string) {
	<!DOCTYPE html>
	<html lang="de-AT">
		@documentHead(data, heading+" – "+data.AppName)
		<body>
			<div class="connectivity-banner" role="status" aria-live="polite" data-connectivity-banner hidden></div>
			<a class="skip-link" href="#hauptinhalt">Zum Inhalt springen</a>
			<main id="hauptinhalt" class="page error-page">
				<div class="error-code" aria-hidden="true">{ fmt.Sprint(status) }</div>
				<h1>{ heading }</h1>
				<p>{ message }</p>
				<a class="button" href="/">Zur Startseite</a>
			</main>
			@siteFooter(data)
			<div class="visually-hidden" aria-live="polite" data-live-status></div>
		</body>
	</html>
}
