package templates

import (
	"example.invalid/hackplan/internal/auth"
	"fmt"
)

type ShellData struct {
	Page      PageData
	Actor     auth.Actor
	CSRFToken string
}
type LoginData struct {
	Page     PageData
	Username string
	Error    string
}
type PasswordData struct {
	Shell ShellData
	Error string
}
type UsersData struct {
	Shell  ShellData
	Users  []auth.UserSummary
	Error  string
	Values CreateUserValues
}
type CreateUserValues struct {
	Username     string
	DisplayName  string
	Email        string
	Role         string
	CreateDriver bool
}

templ appHeader(shell ShellData) {
	<a class="skip-link" href="#hauptinhalt">Zum Inhalt springen</a>
	<header class="site-header">
		<div class="site-header__inner">
			<a class="wordmark" href="/dashboard" aria-label={ shell.Page.AppName + " Übersicht" }><span class="wordmark__mark" aria-hidden="true">H</span><span>{ shell.Page.AppName }</span></a>
			<nav class="primary-nav" aria-label="Hauptnavigation">
				<a href="/dashboard">Übersicht</a><a href="/calendar">Kalender</a><a href="/waitlist">Warteliste</a><a href="/customers">Kunden</a>
				if shell.Actor.Role == auth.RoleDriver {
					<a href="/availability">Meine Verfügbarkeit</a>
				}
				<a href="/profile">Profil</a>
				if shell.Actor.Role == auth.RoleAdmin {
					<a href="/admin/users">Benutzer</a><a href="/admin/drivers">Fahrer</a><a href="/admin/resources">Ressourcen</a>
				}
			</nav>
			<div class="user-menu"><span>{ shell.Actor.DisplayName }</span><span class="role-badge">{ roleLabel(shell.Actor.Role) }</span><form method="post" action="/logout"><input type="hidden" name="csrf_token" value={ shell.CSRFToken }/><button class="button button--quiet" type="submit">Abmelden</button></form></div>
		</div>
	</header>
}

templ appFooter(page PageData) {
	<footer class="site-footer"><div class="site-footer__inner">{ page.AppName } · Europe/Vienna · de-AT · Version { page.Version }</div></footer>
	<div class="visually-hidden" aria-live="polite" data-live-status></div>
}

templ Login(data LoginData) {
	<!DOCTYPE html>
	<html lang="de-AT">
		@documentHead(data.Page, "Anmelden – "+data.Page.AppName)
		<body>
			<a class="skip-link" href="#hauptinhalt">Zum Inhalt springen</a>
			<header class="site-header"><div class="site-header__inner"><a class="wordmark" href="/"><span class="wordmark__mark" aria-hidden="true">H</span><span>{ data.Page.AppName }</span></a></div></header>
			<main id="hauptinhalt" class="page auth-page">
				<section class="form-card" aria-labelledby="login-heading">
					<p class="eyebrow">Interner Zugang</p>
					<h1 id="login-heading">Anmelden</h1>
					<p>Für Administratoren und Fahrer. Es gibt keine öffentliche Registrierung.</p>
					if data.Error != "" {
						<div class="form-alert" role="alert">{ data.Error }</div>
					}
					<form method="post" action="/login" class="form-stack"><label for="username">Benutzername</label><input id="username" name="username" value={ data.Username } autocomplete="username" required autofocus/><label for="password">Passwort</label><input id="password" name="password" type="password" autocomplete="current-password" required/><button class="button" type="submit">Sicher anmelden</button></form>
				</section>
			</main>@appFooter(data.Page)
		</body>
	</html>
}

templ Dashboard(shell ShellData) {
	<!DOCTYPE html>
	<html lang="de-AT">
		@documentHead(shell.Page, "Übersicht – "+shell.Page.AppName)
		<body>
			@appHeader(shell)
			<main id="hauptinhalt" class="page">
				<section class="dashboard-intro"><div><p class="eyebrow">Einsatzübersicht</p><h1>Grüß Gott, { shell.Actor.DisplayName }.</h1><p>Die fachlichen Bereiche werden schrittweise freigeschaltet. Berechtigungen gelten bereits serverseitig.</p></div><span class="status-badge status-badge--ready">Sicher angemeldet</span></section>
				<section class="module-grid" aria-label="Arbeitsbereiche">
					@moduleCard("Kalender", "Alle geplanten Termine werden für alle Fahrer sichtbar.", "Task 04")
					@moduleCard("Kunden & Aufträge", "Getrennte Akten, Aufträge und Warteliste.", "Task 02")
					@moduleCard("Verfügbarkeit", "Eigene Zeiten mobil pflegen.", "Task 03")
				</section>
			</main>@appFooter(shell.Page)
		</body>
	</html>
}

templ moduleCard(title string, description string, status string) {
	<article class="module-card"><span class="module-card__status">{ status }</span><h2>{ title }</h2><p>{ description }</p></article>
}

templ Profile(shell ShellData) {
	<!DOCTYPE html>
	<html lang="de-AT">
		@documentHead(shell.Page, "Profil – "+shell.Page.AppName)
		<body>
			@appHeader(shell)
			<main id="hauptinhalt" class="page narrow-page"><p class="eyebrow">Mein Zugang</p><h1>{ shell.Actor.DisplayName }</h1><dl class="profile-list"><div><dt>Benutzername</dt><dd>{ shell.Actor.Username }</dd></div><div><dt>Rolle</dt><dd>{ roleLabel(shell.Actor.Role) }</dd></div></dl><a class="button" href="/password">Passwort ändern</a></main>@appFooter(shell.Page)
		</body>
	</html>
}

templ Password(data PasswordData) {
	<!DOCTYPE html>
	<html lang="de-AT">
		@documentHead(data.Shell.Page, "Passwort ändern – "+data.Shell.Page.AppName)
		<body>
			@appHeader(data.Shell)
			<main id="hauptinhalt" class="page auth-page">
				<section class="form-card">
					<p class="eyebrow">Kontosicherheit</p>
					<h1>Passwort ändern</h1>
					<p>Verwenden Sie mindestens 14 Zeichen. Nach der Änderung melden Sie sich erneut an.</p>
					if data.Error != "" {
						<div class="form-alert" role="alert">{ data.Error }</div>
					}
					<form method="post" action="/password" class="form-stack"><input type="hidden" name="csrf_token" value={ data.Shell.CSRFToken }/><label for="new-password">Neues Passwort</label><input id="new-password" name="password" type="password" autocomplete="new-password" minlength="14" required/><label for="confirm-password">Passwort wiederholen</label><input id="confirm-password" name="confirmation" type="password" autocomplete="new-password" minlength="14" required/><button class="button" type="submit">Passwort speichern</button></form>
				</section>
			</main>@appFooter(data.Shell.Page)
		</body>
	</html>
}

templ Users(data UsersData) {
	<!DOCTYPE html>
	<html lang="de-AT">
		@documentHead(data.Shell.Page, "Benutzer & Fahrer – "+data.Shell.Page.AppName)
		<body>
			@appHeader(data.Shell)
			<main id="hauptinhalt" class="page">
				<div class="page-heading"><div><p class="eyebrow">Administration</p><h1>Benutzer &amp; Fahrer</h1></div><span class="status-badge">{ fmt.Sprint(len(data.Users)) } Zugänge</span></div>
				if data.Error != "" {
					<div class="form-alert" role="alert">{ data.Error }</div>
				}
				<section class="admin-layout">
					<div class="table-card">
						<div class="table-scroll">
							<table>
								<thead><tr><th>Benutzer</th><th>Rolle</th><th>Status</th><th>Fahrerprofil</th><th>Aktionen</th></tr></thead>
								<tbody>
									for _, user := range data.Users {
										<tr>
											<td><strong>{ user.DisplayName }</strong><small>{ user.Username }</small></td>
											<td>{ roleLabel(user.Role) }</td>
											<td>{ activeLabel(user.Active) }</td>
											<td>{ driverLabel(user.DriverID) }</td>
											<td>
												<form method="post" action={ "/admin/users/" + user.ID + "/access" } class="inline-form"><input type="hidden" name="csrf_token" value={ data.Shell.CSRFToken }/><input type="hidden" name="version" value={ fmt.Sprint(user.Version) }/><select name="role" aria-label={ "Rolle für " + user.Username }><option value="admin" selected?={ user.Role == auth.RoleAdmin }>Admin</option><option value="driver" selected?={ user.Role == auth.RoleDriver }>Fahrer</option></select><label class="check-label"><input type="checkbox" name="active" value="true" checked?={ user.Active }/> aktiv</label><button class="button button--quiet" type="submit">Speichern</button></form>
												<form method="post" action={ "/admin/users/" + user.ID + "/reset-password" } class="inline-form reset-form"><input type="hidden" name="csrf_token" value={ data.Shell.CSRFToken }/><input type="hidden" name="version" value={ fmt.Sprint(user.Version) }/><label><span>Temporäres Passwort</span><input name="password" type="password" autocomplete="new-password" minlength="14" required/></label><button class="button button--quiet" type="submit">Zurücksetzen</button></form>
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					</div>
					<aside class="form-card"><h2>Zugang anlegen</h2><form method="post" action="/admin/users" class="form-stack"><input type="hidden" name="csrf_token" value={ data.Shell.CSRFToken }/><label for="create-username">Benutzername</label><input id="create-username" name="username" value={ data.Values.Username } required/><label for="create-name">Anzeigename</label><input id="create-name" name="display_name" value={ data.Values.DisplayName } required/><label for="create-email">E-Mail (optional)</label><input id="create-email" name="email" type="email" value={ data.Values.Email }/><label for="create-role">Rolle</label><select id="create-role" name="role"><option value="driver" selected?={ data.Values.Role != "admin" }>Fahrer</option><option value="admin" selected?={ data.Values.Role == "admin" }>Admin</option></select><label for="create-password">Temporäres Passwort</label><input id="create-password" name="password" type="password" autocomplete="new-password" minlength="14" required/><label class="check-label"><input name="create_driver" type="checkbox" value="true" checked?={ data.Values.CreateDriver }/> separates Fahrerprofil anlegen</label><button class="button" type="submit">Benutzer anlegen</button></form></aside>
				</section>
			</main>@appFooter(data.Shell.Page)
		</body>
	</html>
}

func roleLabel(role auth.Role) string {
	if role == auth.RoleAdmin {
		return "Administrator"
	}
	return "Fahrer"
}
func activeLabel(active bool) string {
	if active {
		return "Aktiv"
	}
	return "Deaktiviert"
}
func driverLabel(id string) string {
	if id == "" {
		return "Nicht zugeordnet"
	}
	return "Zugeordnet"
}
