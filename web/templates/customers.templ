package templates

import (
	"example.invalid/hackplan/internal/auth"
	"example.invalid/hackplan/internal/customers"
	"fmt"
	"net/mail"
	"net/url"
	"strconv"
	"strings"
	"time"
)

type CustomerListData struct {
	Shell  ShellData
	Page   customers.Page[customers.CustomerSummary]
	Search string
}

type IntakeValues struct {
	FirstName, LastName, CompanyName, Street, PostalCode, Locality, Region, AddressFreeform            string
	Phone, Email, Notification, JobType, Volume, HackDuration, TransportDuration, Trips                string
	TransportMode, PreferredStart, PreferredEnd, PreferenceMode, PreferenceText, Urgency, Source, Note string
	PileLatitude, PileLongitude, PileLocationSource                                                    string
	ExternalConfirmed                                                                                  bool
}

type IntakeData struct {
	Shell          ShellData
	Customers      customers.Page[customers.CustomerSummary]
	CustomerSearch string
	Values         IntakeValues
	Error          string
	FieldErrors    []FormFieldError
}

type FormFieldError struct {
	Field   string
	Label   string
	Message string
}

type CustomerDetailData struct {
	Shell                                     ShellData
	Detail                                    customers.CustomerDetail
	Error, CustomerEditError, CustomerVersion string
	CustomerValues                            IntakeValues
	CustomerFieldErrors                       []FormFieldError
	OpenCustomerEdit, CustomerConflict        bool
	JobEditID, JobEditError, JobVersion       string
	JobValues                                 IntakeValues
	JobFieldErrors                            []FormFieldError
	JobConflict                               bool
}

type WaitlistData struct {
	Shell  ShellData
	Page   customers.Page[customers.WaitlistItem]
	Filter customers.WaitlistFilter
	Error  string
}

type JobFormData struct {
	Shell                                                     ShellData
	CustomerID, CustomerName, CustomerRegion, CustomerAddress string
	Values                                                    IntakeValues
	Error                                                     string
	FieldErrors                                               []FormFieldError
	CustomerLatitude, CustomerLongitude                       string
}

type WorkspaceSearchData struct {
	Shell   ShellData
	Query   string
	Results []customers.SearchResult
	Error   string
}

templ WorkspaceSearch(data WorkspaceSearchData) {
	<!DOCTYPE html>
	<html lang="de-AT">
		@documentHead(data.Shell.Page, "Globale Suche – "+data.Shell.Page.AppName)
		<body>
			@appHeader(data.Shell)
			<main id="hauptinhalt" class="page narrow-page">
				<p class="eyebrow">Arbeitsbereich</p>
				<h1>Globale Suche</h1>
				<p>Die Suchanfrage wird nicht in URL, Verlauf oder Browser-Storage gespeichert.</p>
				<form method="post" action="/search" class="filter-bar">
					<input type="hidden" name="csrf_token" value={ data.Shell.CSRFToken }/>
					<label>Suchbegriff<input name="q" type="search" minlength="2" maxlength="120" value={ data.Query } required autofocus/></label>
					<button class="button" type="submit">Suchen</button>
				</form>
				if data.Error != "" {
					<div class="form-alert" role="alert">{ data.Error }</div>
				}
				if data.Error == "" && len(data.Results) == 0 {
					<div class="empty-state"><h2>Keine Treffer</h2><p>Kundenname, Auftragsnummer oder Terminbezug prüfen.</p></div>
				}
				if len(data.Results) > 0 {
					<div class="compact-list search-results">
						for _, result := range data.Results {
							<a class="search-result" href={ result.Href }><span class="status-badge">{ searchKindLabel(result.Kind) }</span><strong>{ result.Title }</strong><small>{ result.Subtitle }</small></a>
						}
					</div>
				}
			</main>
			@appFooter(data.Shell.Page)
		</body>
	</html>
}

func searchKindLabel(kind string) string {
	switch kind {
	case "customer":
		return "Kunde"
	case "job":
		return "Auftrag"
	default:
		return "Termin"
	}
}

func jobLocationValues(job customers.Job) IntakeValues {
	values := IntakeValues{PileLocationSource: string(job.PileLocationSource)}
	if job.PileLatitude != nil {
		values.PileLatitude = strconv.FormatFloat(*job.PileLatitude, 'f', 6, 64)
	}
	if job.PileLongitude != nil {
		values.PileLongitude = strconv.FormatFloat(*job.PileLongitude, 'f', 6, 64)
	}
	return values
}

func coordinateValue(value *float64) string {
	if value == nil {
		return ""
	}
	return strconv.FormatFloat(*value, 'f', 6, 64)
}

func pileSourceLabel(value customers.PileLocationSource) string {
	switch value {
	case customers.PileSourceCustomerAddress:
		return "von der Kundenadresse übernommen"
	case customers.PileSourceDeviceLocation:
		return "vom Gerätestandort übernommen"
	case customers.PileSourceCoordinates:
		return "über Koordinaten erfasst"
	default:
		return "auf der Karte gesetzt"
	}
}

templ mapAssetData(page PageData) {
	<span hidden data-map-assets data-map-script={ page.MapLibreJSPath } data-map-worker={ page.MapLibreWorkerPath } data-map-css={ page.MapLibreCSSPath } data-map-attribution={ page.MapAttribution }></span>
}

templ jobLocationEditor(page PageData, prefix string, values IntakeValues, customerLatitude string, customerLongitude string, customerAddress string, fieldErrors []FormFieldError) {
	<section class="job-location-editor span-2" data-job-location-editor data-initial-latitude={ values.PileLatitude } data-initial-longitude={ values.PileLongitude } data-initial-source={ values.PileLocationSource } data-customer-latitude={ customerLatitude } data-customer-longitude={ customerLongitude } data-customer-address={ customerAddress }>
		@mapAssetData(page)
		<div class="section-heading"><div><p class="eyebrow">Einsatzort</p><h3 id={ prefix + "-pile-map-heading" }>Hackschnitzelhaufen markieren</h3></div><span class="status-badge" data-location-badge>{ locationBadge(values) }</span></div>
		<p>Der Haufenstandort ist vom Kundenstandort getrennt. Erst „Standort übernehmen“ schreibt die gewählte Position in das Formular.</p>
		<div class="location-search" data-location-search>
			<label for={ prefix + "-pile-address-search" }>Adresse oder Ort suchen</label>
			<div class="location-search__bar">
				<input id={ prefix + "-pile-address-search" } type="search" maxlength="200" autocomplete="off" placeholder="z. B. Waldstraße 9, Unterneukirchen" data-location-search-input disabled?={ !page.GeocodingEnabled }/>
				<button class="button button--quiet" type="button" data-location-search-submit disabled?={ !page.GeocodingEnabled }>Karte ausrichten</button>
			</div>
			if page.GeocodingEnabled {
				<p class="form-hint">Die eingegebene Adresse wird zur Suche an den konfigurierten Kartendienst übertragen und nicht von HackWerk gespeichert.</p>
			} else {
				<p class="form-hint">Die externe Adresssuche ist für diese Installation nicht konfiguriert. Karte und Koordinaten bleiben vollständig nutzbar.</p>
			}
			<p class="form-hint location-search__status" data-location-search-status aria-live="polite"></p>
			<ul class="location-search__results" data-location-search-results aria-label="Gefundene Adressen" hidden></ul>
		</div>
		<p class="form-hint" id={ prefix + "-pile-map-hint" }>Position auf der Karte anklicken oder die Koordinaten darunter eingeben. Beide Wege erfordern anschließend „Standort übernehmen“.</p>
		<div id={ prefix + "-pile-map" } class="job-location-map" data-map-canvas role="region" aria-labelledby={ prefix + "-pile-map-heading" } aria-describedby={ prefix + "-pile-map-hint" }><div class="map-fallback" data-map-fallback>Die Straßenkarte wird geladen. Koordinaten können jederzeit direkt eingegeben werden.</div></div>
		<div class="coordinate-grid">
			<label for={ prefix + "-pile-latitude" }>Breitengrad<input id={ prefix + "-pile-latitude" } data-location-latitude inputmode="decimal" value={ values.PileLatitude } aria-invalid={ coordinateFieldInvalid(fieldErrors) } aria-describedby={ coordinateFieldDescription(prefix, fieldErrors) }/></label>
			<label for={ prefix + "-pile-longitude" }>Längengrad<input id={ prefix + "-pile-longitude" } data-location-longitude inputmode="decimal" value={ values.PileLongitude } aria-invalid={ coordinateFieldInvalid(fieldErrors) } aria-describedby={ coordinateFieldDescription(prefix, fieldErrors) }/></label>
		</div>
		if coordinateFieldError(fieldErrors) != "" {
			<small id={ prefix + "-pile-coordinate-error" } class="field-error">{ coordinateFieldError(fieldErrors) }</small>
		}
		<input type="hidden" name="pile_latitude" value={ values.PileLatitude } data-location-committed-latitude/>
		<input type="hidden" name="pile_longitude" value={ values.PileLongitude } data-location-committed-longitude/>
		<input type="hidden" name="pile_location_source" value={ values.PileLocationSource } data-location-committed-source/>
		<div class="location-actions">
			<div class="location-customer-choice"><button class="button button--quiet" type="button" aria-describedby={ prefix + "-customer-address-hint" } data-location-customer>Kundenadresse wählen</button><small id={ prefix + "-customer-address-hint" } data-location-customer-address>{ customerAddressHint(customerAddress) }</small></div>
			<button class="button button--quiet" type="button" data-location-device>Meinen Standort verwenden</button>
			<button class="button" type="button" data-location-commit>Standort übernehmen</button>
			<button class="button button--quiet" type="button" data-location-clear>Standort entfernen</button>
		</div>
		<p class="form-hint" data-location-message aria-live="polite">{ locationMessage(values) }</p>
	</section>
}

func coordinateFieldError(fieldErrors []FormFieldError) string {
	if message := formFieldError(fieldErrors, "pile_latitude"); message != "" {
		return message
	}
	return formFieldError(fieldErrors, "pile_longitude")
}

func coordinateFieldInvalid(fieldErrors []FormFieldError) string {
	return strconv.FormatBool(coordinateFieldError(fieldErrors) != "")
}

func coordinateFieldDescription(prefix string, fieldErrors []FormFieldError) string {
	if coordinateFieldError(fieldErrors) == "" {
		return ""
	}
	return prefix + "-pile-coordinate-error"
}

func locationBadge(values IntakeValues) string {
	if values.PileLatitude != "" && values.PileLongitude != "" {
		return "Gespeichert"
	}
	return "Fehlt"
}

func locationMessage(values IntakeValues) string {
	if values.PileLatitude != "" && values.PileLongitude != "" {
		return "Der gespeicherte Haufenstandort ist geladen."
	}
	return "Noch kein Haufenstandort gespeichert."
}

templ jobLocationPreview(page PageData, job customers.Job) {
	<section class="job-location-preview" aria-label="Haufenstandort">
		<div class="section-heading">
			<div>
				<p class="eyebrow">Haufenstandort</p>
				if job.PileLatitude != nil && job.PileLongitude != nil {
					<h4>Einsatzort auf der Karte</h4>
				} else {
					<h4>Standort fehlt</h4>
				}
			</div>
			if job.PileLatitude != nil && job.PileLongitude != nil {
				<span class="status-badge">{ pileSourceLabel(job.PileLocationSource) }</span>
			} else {
				<span class="status-badge">nicht routierbar</span>
			}
		</div>
		if job.PileLatitude != nil && job.PileLongitude != nil {
			@mapAssetData(page)
			<div id={ "preview-" + job.ID + "-pile-map" } class="job-location-map job-location-map--preview" data-map-preview data-latitude={ coordinateValue(job.PileLatitude) } data-longitude={ coordinateValue(job.PileLongitude) }><div class="map-fallback" data-map-fallback>Kartenvorschau wird geladen.</div></div>
			<div class="location-preview-meta"><span>{ coordinateValue(job.PileLatitude) }, { coordinateValue(job.PileLongitude) }</span><a class="button button--quiet" href={ job.PileMapsURL } target="_blank" rel="noopener noreferrer">In Google Maps öffnen</a></div>
		} else {
			<p class="empty-copy">Setzen Sie den tatsächlichen Standort des Hackschnitzelhaufens, damit der Auftrag auf der Routenkarte erscheint.</p>
		}
	</section>
}

func formFieldError(fieldErrors []FormFieldError, field string) string {
	for _, item := range fieldErrors {
		if item.Field == field {
			return item.Message
		}
	}
	return ""
}

func formFieldInvalid(fieldErrors []FormFieldError, field string) string {
	return strconv.FormatBool(formFieldError(fieldErrors, field) != "")
}

func formFieldDescription(fieldErrors []FormFieldError, field string) string {
	if formFieldError(fieldErrors, field) == "" {
		return ""
	}
	return field + "-error"
}

func customerPhoneURL(value string) string {
	phone := customers.NormalizePhone(value)
	if phone == "" {
		return ""
	}
	return (&url.URL{Scheme: "tel", Opaque: phone}).String()
}

func customerEmailURL(value string) string {
	address, err := mail.ParseAddress(value)
	if err != nil || address.Address != value || strings.ContainsAny(value, "\r\n") {
		return ""
	}
	return (&url.URL{Scheme: "mailto", Opaque: address.Address}).String()
}

templ formErrorSummary(message string, fieldErrors []FormFieldError) {
	if message != "" {
		<div class="form-alert" role="alert" tabindex="-1" data-error-summary>
			<strong>{ message }</strong>
			if len(fieldErrors) > 0 {
				<ul>
					for _, item := range fieldErrors {
						<li><a href={ "#" + item.Field }>{ item.Label }: { item.Message }</a></li>
					}
				</ul>
			}
		</div>
	}
}

templ formFieldMessage(fieldErrors []FormFieldError, field string) {
	if formFieldError(fieldErrors, field) != "" {
		<small id={ field + "-error" } class="field-error">{ formFieldError(fieldErrors, field) }</small>
	}
}

func formHasAnyError(fieldErrors []FormFieldError, fields ...string) bool {
	for _, field := range fields {
		if formFieldError(fieldErrors, field) != "" {
			return true
		}
	}
	return false
}

func hasAnyText(values ...string) bool {
	for _, value := range values {
		if strings.TrimSpace(value) != "" {
			return true
		}
	}
	return false
}

func jobAdditionalOpen(values IntakeValues, fieldErrors []FormFieldError) bool {
	return hasAnyText(values.PreferenceText, values.Note) || formHasAnyError(fieldErrors, "preference_text", "note")
}

func jobLocationOpen(values IntakeValues, fieldErrors []FormFieldError) bool {
	return hasAnyText(values.PileLatitude, values.PileLongitude) || formHasAnyError(fieldErrors, "pile_latitude", "pile_longitude")
}

templ customerFormFields(values IntakeValues, fieldErrors []FormFieldError) {
	<div class="customer-form-sections" data-customer-fields>
		<fieldset class="compact-form-section customer-form-section customer-form-section--identity">
			<legend>Identität</legend>
			<div class="customer-field-grid customer-identity-grid">
				<label>
					Vorname<input id="first_name" name="first_name" value={ values.FirstName } aria-invalid={ formFieldInvalid(fieldErrors, "first_name") } aria-describedby={ formFieldDescription(fieldErrors, "first_name") }/>@formFieldMessage(fieldErrors, "first_name")
				</label>
				<label>Nachname<input name="last_name" value={ values.LastName }/></label>
				<label class="customer-field--wide">Firma<input name="company_name" value={ values.CompanyName }/></label>
			</div>
		</fieldset>
		<fieldset class="compact-form-section customer-form-section customer-form-section--address">
			<legend>Adresse</legend>
			<div class="customer-field-grid customer-address-grid">
				<label class="customer-field--street">Straße / Hausnummer<input name="street" value={ values.Street }/></label>
				<label class="customer-field--postal">Postleitzahl<input name="postal_code" inputmode="numeric" value={ values.PostalCode }/></label>
				<label>Ort<input name="locality" value={ values.Locality }/></label>
				<label>Region<input name="region" value={ values.Region }/></label>
			</div>
		</fieldset>
		<fieldset class="compact-form-section customer-form-section customer-form-section--contact">
			<legend>Kontakt</legend>
			<div class="customer-field-grid customer-contact-grid">
				<label>
					Telefon<input id="phone" name="phone" type="tel" value={ values.Phone } aria-invalid={ formFieldInvalid(fieldErrors, "phone") } aria-describedby={ formFieldDescription(fieldErrors, "phone") }/>@formFieldMessage(fieldErrors, "phone")
				</label>
				<label class="customer-field--wide">
					E-Mail<input id="email" name="email" type="email" value={ values.Email } aria-invalid={ formFieldInvalid(fieldErrors, "email") } aria-describedby={ formFieldDescription(fieldErrors, "email") }/>@formFieldMessage(fieldErrors, "email")
				</label>
				<label>
					Benachrichtigung<select id="notification" name="notification" aria-invalid={ formFieldInvalid(fieldErrors, "notification") } aria-describedby={ formFieldDescription(fieldErrors, "notification") }><option value="none" selected?={ values.Notification == "none" }>Keine</option><option value="email" selected?={ values.Notification == "email" }>E-Mail</option><option value="sms" selected?={ values.Notification == "sms" }>SMS</option><option value="both" selected?={ values.Notification == "both" }>Beide</option></select>@formFieldMessage(fieldErrors, "notification")
				</label>
			</div>
		</fieldset>
		<details class="form-disclosure customer-address-extra" open?={ hasAnyText(values.AddressFreeform) || formHasAnyError(fieldErrors, "address_freeform") }>
			<summary><span>Freie Adressangabe</span><small>Nur für unvollständige oder ergänzende Angaben</small></summary>
			<div class="form-disclosure__body">
				<label>Zusätzliche Adressangabe<textarea name="address_freeform">{ values.AddressFreeform }</textarea></label>
			</div>
		</details>
	</div>
}

templ jobIntakeFields(page PageData, prefix string, values IntakeValues, fieldErrors []FormFieldError, customerLatitude string, customerLongitude string, customerAddress string, customerRegion string) {
	<fieldset class="compact-form-section job-form-section job-core-section">
		<legend>Hackauftrag</legend>
		<div class="job-core-grid">
			<label class="compact-field">
				Auftragstyp<select id="job_type" name="job_type" required data-job-type aria-invalid={ formFieldInvalid(fieldErrors, "job_type") } aria-describedby={ formFieldDescription(fieldErrors, "job_type") }><option value="chipping_only" selected?={ values.JobType == "chipping_only" }>Nur Hackmaschine</option><option value="chipping_with_transport" selected?={ values.JobType == "chipping_with_transport" }>Hackmaschine mit Transport</option></select>@formFieldMessage(fieldErrors, "job_type")
			</label>
			<label class="compact-field">
				Menge in m³
				<span class="compact-control-with-tools">
					<input id="volume_m3" name="volume_m3" inputmode="decimal" value={ values.Volume } required data-volume-input aria-invalid={ formFieldInvalid(fieldErrors, "volume_m3") } aria-describedby={ formFieldDescription(fieldErrors, "volume_m3") }/>
					<span class="compact-field-tools" aria-label="Mengen-Schnellauswahl"><button class="button button--quiet" type="button" data-volume-preset="30">30</button><button class="button button--quiet" type="button" data-volume-preset="50">50</button><button class="button button--quiet" type="button" data-volume-preset="100">100</button></span>
				</span>
				@formFieldMessage(fieldErrors, "volume_m3")
			</label>
			<label class="compact-field">
				Hackdauer
				<span class="compact-control-with-tools">
					<input id="hack_duration" name="hack_duration" placeholder="z. B. 3:30" value={ values.HackDuration } required data-duration-input="hack" aria-invalid={ formFieldInvalid(fieldErrors, "hack_duration") } aria-describedby={ formFieldDescription(fieldErrors, "hack_duration") }/>
					<span class="compact-field-tools" aria-label="Hackdauer anpassen"><button class="button button--quiet" type="button" data-duration-adjust="-15" data-duration-target="hack">−15</button><button class="button button--quiet" type="button" data-duration-adjust="15" data-duration-target="hack">+15</button></span>
				</span>
				<small>Stunden:Minuten oder Gesamtminuten</small>@formFieldMessage(fieldErrors, "hack_duration")
			</label>
			<p class="form-hint job-duration-summary" data-job-duration-summary>Gesamtdauer wird aus Hack- und Transportdauer berechnet.</p>
			<div class="job-transport-grid" data-transport-field>
				<label class="compact-field">
					Transportdauer
					<span class="compact-control-with-tools">
						<input id="transport_duration" name="transport_duration" placeholder="z. B. 1:00" value={ values.TransportDuration } data-transport-control data-duration-input="transport" aria-invalid={ formFieldInvalid(fieldErrors, "transport_duration") } aria-describedby={ formFieldDescription(fieldErrors, "transport_duration") }/>
						<span class="compact-field-tools" aria-label="Transportdauer anpassen"><button class="button button--quiet" type="button" data-duration-adjust="-15" data-duration-target="transport">−15</button><button class="button button--quiet" type="button" data-duration-adjust="15" data-duration-target="transport">+15</button></span>
					</span>
					@formFieldMessage(fieldErrors, "transport_duration")
				</label>
				<label class="compact-field">
					Transportfahrten<input id="transport_trips" name="transport_trips" type="number" min="0" max="1000" value={ values.Trips } data-transport-control aria-invalid={ formFieldInvalid(fieldErrors, "transport_trips") } aria-describedby={ formFieldDescription(fieldErrors, "transport_trips") }/>@formFieldMessage(fieldErrors, "transport_trips")
				</label>
				<label class="compact-field">
					Transportmodus<select id="transport_mode" name="transport_mode" data-transport-control data-transport-mode aria-invalid={ formFieldInvalid(fieldErrors, "transport_mode") } aria-describedby={ formFieldDescription(fieldErrors, "transport_mode") }><option value="none" selected?={ values.TransportMode == "none" }>Kein Transport</option><option value="undecided" selected?={ values.TransportMode == "undecided" }>Noch offen</option><option value="internal" selected?={ values.TransportMode == "internal" }>Intern</option><option value="external" selected?={ values.TransportMode == "external" }>Extern</option></select>@formFieldMessage(fieldErrors, "transport_mode")
				</label>
				<div class="compact-check-field" data-external-confirmation>
					<label class="check-label"><input id="external_confirmed" name="external_confirmed" type="checkbox" value="true" checked?={ values.ExternalConfirmed } aria-invalid={ formFieldInvalid(fieldErrors, "external_confirmed") } aria-describedby={ formFieldDescription(fieldErrors, "external_confirmed") }/> Externer Transport bestätigt</label>@formFieldMessage(fieldErrors, "external_confirmed")
				</div>
			</div>
		</div>
	</fieldset>
	<fieldset class="compact-form-section job-form-section job-preference-section">
		<legend>Wunsch &amp; Warteliste</legend>
		<div class="job-preference-grid">
			<label class="compact-field">
				Terminpräferenz<select id="preference_mode" name="preference_mode" required><option value="window" selected?={ values.PreferenceMode == "window" }>Zeitraum</option><option value="fixed" selected?={ values.PreferenceMode == "fixed" }>Fixes Datum</option><option value="flexible" selected?={ values.PreferenceMode == "flexible" }>Flexibel</option></select>
			</label>
			<label class="compact-field">
				Frühestes Datum<input id="preferred_start" name="preferred_start" type="date" value={ values.PreferredStart } data-date-range-start aria-invalid={ formFieldInvalid(fieldErrors, "preferred_start") } aria-describedby={ formFieldDescription(fieldErrors, "preferred_start") }/>@formFieldMessage(fieldErrors, "preferred_start")
			</label>
			<label class="compact-field">
				Spätestes Datum<input id="preferred_end" name="preferred_end" type="date" value={ values.PreferredEnd } data-date-range-end aria-invalid={ formFieldInvalid(fieldErrors, "preferred_end") } aria-describedby={ formFieldDescription(fieldErrors, "preferred_end") }/>@formFieldMessage(fieldErrors, "preferred_end")
			</label>
			<label class="compact-field">
				Dringlichkeit<select name="urgency"><option value="normal" selected?={ values.Urgency == "normal" }>Normal</option><option value="low" selected?={ values.Urgency == "low" }>Niedrig</option><option value="high" selected?={ values.Urgency == "high" }>Hoch</option><option value="urgent" selected?={ values.Urgency == "urgent" }>Dringend</option></select>
			</label>
			<label class="compact-field job-region-field">
				Region
				<span class="compact-control-with-tools"><input name="region" value={ values.Region } data-job-region/><button class="button button--quiet compact-copy-region" type="button" data-copy-customer-region={ customerRegion }>Übernehmen</button></span>
			</label>
			<label class="compact-field">Quelle<select name="source"><option value="phone" selected?={ values.Source == "phone" }>Telefon</option><option value="email" selected?={ values.Source == "email" }>E-Mail</option><option value="in_person" selected?={ values.Source == "in_person" }>Persönlich</option><option value="other" selected?={ values.Source == "other" }>Sonstige</option></select></label>
			<div class="compact-field-tools job-date-presets" aria-label="Zeitraum-Schnellauswahl"><button class="button button--quiet" type="button" data-date-range-preset data-start-offset="0" data-day-span="7">Diese Woche</button><button class="button button--quiet" type="button" data-date-range-preset data-start-offset="7" data-day-span="7">Nächste Woche</button><button class="button button--quiet" type="button" data-date-range-preset data-start-offset="0" data-day-span="30">30 Tage</button></div>
		</div>
	</fieldset>
	<details class="form-disclosure job-additional-disclosure" open?={ jobAdditionalOpen(values, fieldErrors) }>
		<summary><span>Zusätzliche Angaben</span><small>Wunschtext und interne Bemerkung</small></summary>
		<div class="form-disclosure__body job-additional-grid">
			<label>Wunsch als Freitext<textarea name="preference_text">{ values.PreferenceText }</textarea></label>
			<label>Interne Bemerkung<textarea name="note" maxlength="4000" data-note-input>{ values.Note }</textarea><small class="compact-field-tools"><button class="button button--quiet" type="button" data-note-template="Rückruf erbeten. ">Rückruf</button><button class="button button--quiet" type="button" data-note-template="Zufahrt vorab prüfen. ">Zufahrt prüfen</button></small></label>
		</div>
	</details>
	<details class="form-disclosure job-location-disclosure" open?={ jobLocationOpen(values, fieldErrors) }>
		<summary><span>Haufenstandort</span><span class="status-badge">{ locationBadge(values) }</span></summary>
		<div class="form-disclosure__body">
			@jobLocationEditor(page, prefix, values, customerLatitude, customerLongitude, customerAddress, fieldErrors)
		</div>
	</details>
}

templ Customers(data CustomerListData) {
	<!DOCTYPE html>
	<html lang="de-AT">
		@documentHead(data.Shell.Page, "Kunden – "+data.Shell.Page.AppName)
		<body>
			@appHeader(data.Shell)
			<main id="hauptinhalt" class="page compact-page customer-page">
				<div class="page-heading"><div><p class="eyebrow">Kundenakten</p><h1>Kunden &amp; Aufträge</h1><p>Kompakte Übersicht über Kontakte und Auftragsbestand.</p></div><div class="action-row"><a class="button button--quiet" href="/voice">Sprachentwurf</a><a class="button mobile-redundant-primary-action" href="/customers/new">Neuer Auftrag</a></div></div>
				<form id="customer-list-controls" method="post" action="/customers/search" class="customer-list-toolbar">
					<input type="hidden" name="csrf_token" value={ data.Shell.CSRFToken }/><input type="hidden" name="sort" value={ data.Page.CustomerFilter.Sort }/><input type="hidden" name="direction" value={ data.Page.CustomerFilter.Direction }/>
					<div class="customer-list-toolbar__search">
						<label for="customer-search" class="visually-hidden">Kunden durchsuchen</label>
						<input id="customer-search" name="q" type="search" value={ data.Search } placeholder="Name, Firma, Ort, Telefon oder Auftragsnummer" autocomplete="off" data-primary-search/>
						<output class="customer-result-count" for="customer-search">{ fmt.Sprint(data.Page.Total) } Treffer</output>
						<button class="button button--quiet" type="submit">Suchen</button>
						<a class="button button--quiet" href="/customers">Zurücksetzen</a>
					</div>
					<div class="list-sort-controls" role="group" aria-label="Kunden sortieren">
						<label>Sortierung<select name="order"><option value="recent:desc" selected?={ data.Page.CustomerFilter.Sort == "recent" && data.Page.CustomerFilter.Direction == "desc" }>Zuletzt geändert</option><option value="recent:asc" selected?={ data.Page.CustomerFilter.Sort == "recent" && data.Page.CustomerFilter.Direction == "asc" }>Älteste Änderung</option><option value="name:asc" selected?={ data.Page.CustomerFilter.Sort == "name" && data.Page.CustomerFilter.Direction == "asc" }>Name A–Z</option><option value="name:desc" selected?={ data.Page.CustomerFilter.Sort == "name" && data.Page.CustomerFilter.Direction == "desc" }>Name Z–A</option><option value="locality:asc" selected?={ data.Page.CustomerFilter.Sort == "locality" && data.Page.CustomerFilter.Direction == "asc" }>Ort A–Z</option><option value="locality:desc" selected?={ data.Page.CustomerFilter.Sort == "locality" && data.Page.CustomerFilter.Direction == "desc" }>Ort Z–A</option><option value="jobs:desc" selected?={ data.Page.CustomerFilter.Sort == "jobs" && data.Page.CustomerFilter.Direction == "desc" }>Meiste Aufträge</option><option value="jobs:asc" selected?={ data.Page.CustomerFilter.Sort == "jobs" && data.Page.CustomerFilter.Direction == "asc" }>Wenigste Aufträge</option></select></label>
						<button class="button button--quiet" type="submit">Sortieren</button>
					</div>
					<details class="customer-filter-menu" open?={ customerFilterCount(data.Page.CustomerFilter) > 0 }>
						<summary>Filter <span class="customer-filter-count">{ fmt.Sprint(customerFilterCount(data.Page.CustomerFilter)) }</span></summary>
						<div class="customer-filter-menu__panel">
							<div class="customer-filter-grid">
								<label class="customer-filter-chip"><input name="missing_contact" type="checkbox" value="1" checked?={ data.Page.CustomerFilter.MissingContact }/> Kontaktdaten fehlen</label>
								<label class="customer-filter-chip"><input name="incomplete_address" type="checkbox" value="1" checked?={ data.Page.CustomerFilter.IncompleteAddress }/> Adresse unvollständig</label>
								<label>Auftragsbestand<select name="job_activity"><option value="">Alle</option><option value="active" selected?={ data.Page.CustomerFilter.JobActivity == customers.CustomerJobsActive }>Aktive Aufträge vorhanden</option><option value="none" selected?={ data.Page.CustomerFilter.JobActivity == customers.CustomerJobsNone }>Ohne aktiven Auftrag</option></select></label>
								<label>Benachrichtigung<select name="notification"><option value="">Alle Präferenzen</option><option value="email" selected?={ data.Page.CustomerFilter.NotificationPreference == customers.NotifyEmail }>E-Mail</option><option value="sms" selected?={ data.Page.CustomerFilter.NotificationPreference == customers.NotifySMS }>SMS</option><option value="both" selected?={ data.Page.CustomerFilter.NotificationPreference == customers.NotifyBoth }>E-Mail und SMS</option><option value="none" selected?={ data.Page.CustomerFilter.NotificationPreference == customers.NotifyNone }>Keine Benachrichtigung</option></select></label>
								<label>Ort<input name="locality" value={ data.Page.CustomerFilter.Locality } placeholder="Ort filtern"/></label>
								<label>Region<input name="region" value={ data.Page.CustomerFilter.Region } placeholder="Region filtern"/></label>
								if data.Shell.Actor.Role == auth.RoleAdmin {
									<label class="customer-filter-chip"><input name="archived" type="checkbox" value="1" checked?={ data.Page.CustomerFilter.IncludeArchived }/> Archiv einblenden</label>
								}
							</div>
							<div class="customer-filter-actions"><button class="button" type="submit">Filter anwenden</button><a class="button button--quiet" href="/customers">Alle zurücksetzen</a></div>
						</div>
					</details>
				</form>
				if len(data.Page.Recent) > 0 {
					<details class="compact-filter-panel">
						<summary>Zuletzt geöffnet ({ fmt.Sprint(len(data.Page.Recent)) })</summary>
						<div class="action-row">
							for _, item := range data.Page.Recent {
								if item.JobID != "" {
									<form method="post" action={ "/recent/jobs/" + item.JobID }><input type="hidden" name="csrf_token" value={ data.Shell.CSRFToken }/><button class="button button--quiet" type="submit">{ item.Label } · { item.Context }</button></form>
								} else {
									<form method="post" action={ "/recent/customers/" + item.CustomerID }><input type="hidden" name="csrf_token" value={ data.Shell.CSRFToken }/><button class="button button--quiet" type="submit">{ item.Label } · { item.Context }</button></form>
								}
							}
						</div>
					</details>
				}
				if len(data.Page.Items) > 0 {
					<div class="table-card compact-table-wrap">
						<table class="compact-table responsive-table customer-table">
							<caption class="visually-hidden">Kundenliste mit Kontaktstatus, Ort, aktiven und historischen Aufträgen sowie letzter Änderung.</caption>
							<thead>
								<tr>
									<th aria-sort={ customerAriaSort(data.Page.CustomerFilter, "name") }><button class={ customerTableSortClass(data.Page.CustomerFilter, "name") } type="submit" name="order" value={ customerSortOrder(data.Page.CustomerFilter, "name") } form="customer-list-controls">Kunde { customerSortMark(data.Page.CustomerFilter, "name") }</button></th>
									<th aria-sort={ customerAriaSort(data.Page.CustomerFilter, "locality") }><button class={ customerTableSortClass(data.Page.CustomerFilter, "locality") } type="submit" name="order" value={ customerSortOrder(data.Page.CustomerFilter, "locality") } form="customer-list-controls">Ort { customerSortMark(data.Page.CustomerFilter, "locality") }</button></th>
									<th>Kontakt</th>
									<th aria-sort={ customerAriaSort(data.Page.CustomerFilter, "jobs") }><button class={ customerTableSortClass(data.Page.CustomerFilter, "jobs") } type="submit" name="order" value={ customerSortOrder(data.Page.CustomerFilter, "jobs") } form="customer-list-controls">Aufträge aktiv / historisch { customerSortMark(data.Page.CustomerFilter, "jobs") }</button></th>
									<th aria-sort={ customerAriaSort(data.Page.CustomerFilter, "recent") }><button class={ customerTableSortClass(data.Page.CustomerFilter, "recent") } type="submit" name="order" value={ customerSortOrder(data.Page.CustomerFilter, "recent") } form="customer-list-controls">Zuletzt geändert { customerSortMark(data.Page.CustomerFilter, "recent") }</button></th>
									<th>Aktion</th>
								</tr>
							</thead>
							<tbody>
								for _, customer := range data.Page.Items {
									<tr data-record-id={ customer.ID }>
										<td data-label="Kunde">
											<a class="customer-name-link" href={ "/customers/" + customer.ID }>{ customerName(customer.FirstName, customer.LastName, customer.CompanyName) }</a><small>{ fallback(customer.Region) }</small>
										</td>
										<td data-label="Ort">
											{ fallback(customer.Locality) }
											if !customer.AddressComplete {
												<span class="status-badge">Adresse unvollständig</span>
											}
										</td>
										<td data-label="Kontakt"><span class="status-badge">{ customerContactLabel(customer) }</span></td>
										<td data-label="Aufträge"><strong>{ fmt.Sprint(customer.ActiveJobCount) }</strong> / { fmt.Sprint(customer.HistoricalJobCount) }</td>
										<td data-label="Zuletzt geändert">
											{ customerLocalDateTime(customer.LastUsedAt) }
											if customer.Archived {
												<span class="status-badge">Archiviert</span>
											}
										</td>
										<td data-label="Aktion">
											<div class="table-row-actions">
												<form method="post" action={ "/recent/customers/" + customer.ID }><input type="hidden" name="csrf_token" value={ data.Shell.CSRFToken }/><button class="button button--quiet table-action" type="submit">Kundenakte öffnen</button></form>
												if customer.MapsURL != "" {
													<a class="button button--quiet" href={ customer.MapsURL } target="_blank" rel="noopener noreferrer">Maps</a>
												}
											</div>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				} else {
					if data.Search != "" || customerFilterCount(data.Page.CustomerFilter) > 0 {
						<div class="empty-state"><h2>Keine passenden Kunden</h2><p>Suche oder Filter liefern keine Treffer.</p><a class="button button--quiet" href="/customers">Suche und Filter zurücksetzen</a></div>
					} else {
						<div class="empty-state"><h2>Noch keine Kunden</h2><p>Erfassen Sie den ersten Auftrag; dabei entsteht die Kundenakte.</p><a class="button" href="/customers/new">Ersten Auftrag erfassen</a></div>
					}
				}
				@customerPagination(data)
			</main>@appFooter(data.Shell.Page)
		</body>
	</html>
}

templ Intake(data IntakeData) {
	<!DOCTYPE html>
	<html lang="de-AT">
		@documentHead(data.Shell.Page, "Neuer Auftrag – "+data.Shell.Page.AppName)
		<body>
			@appHeader(data.Shell)
			<main id="hauptinhalt" class="page compact-page">
				<div class="page-heading"><div><p class="eyebrow">Erfassung</p><h1>Neuer Auftrag</h1><p>Wählen Sie zuerst einen bestehenden Kunden oder legen Sie eine neue Kundenakte an.</p></div><a class="button button--quiet" href="/customers">Abbrechen</a></div>
				<section class="intake-customer-picker" aria-labelledby="existing-customer-heading">
					<div class="section-heading"><div><p class="eyebrow">Schnellauswahl</p><h2 id="existing-customer-heading">Kunde für den Auftrag auswählen</h2></div><span class="status-badge">{ fmt.Sprint(data.Customers.Total) } Treffer</span></div>
					<form method="post" action="/customers/new/search" class="filter-bar compact-filter">
						<input type="hidden" name="csrf_token" value={ data.Shell.CSRFToken }/>
						<label for="intake-customer-search">Kunde suchen</label>
						<input id="intake-customer-search" class="intake-customer-search" name="q" type="search" size="1" value={ data.CustomerSearch } placeholder="Name, Firma, Ort, Telefon oder Auftragsnummer" autocomplete="off"/>
						<button class="button button--quiet" type="submit">Suchen</button>
					</form>
					@formErrorSummary(data.Error, data.FieldErrors)
					<details class="compact-create-panel intake-new-customer" data-new-customer-panel open?={ data.Error != "" }>
						<summary>+ Neuer Kunde mit Auftrag</summary>
						<form method="post" action="/customers" class="intake-form customer-job-workbench" data-transport-form data-sticky-actions>
							<input type="hidden" name="csrf_token" value={ data.Shell.CSRFToken }/><input type="hidden" name="transport_mode" value="none" data-transport-default disabled/>
							@customerFormFields(data.Values, data.FieldErrors)
							@jobIntakeFields(data.Shell.Page, "new-intake-job", data.Values, data.FieldErrors, "", "", intakeCustomerAddress(data.Values), data.Values.Region)
							<div class="form-actions workbench-form-actions"><p>Es wird noch kein Termin erzeugt.</p><button class="button" type="submit">Kunde &amp; Auftrag auf Warteliste setzen</button></div>
						</form>
					</details>
					if len(data.Customers.Items) > 0 {
						<div class="table-card compact-table-wrap">
							<table class="compact-table responsive-table intake-customer-table">
								<thead><tr><th>Kunde</th><th>Ort</th><th>Region</th><th>Aufträge</th><th>Aktion</th></tr></thead>
								<tbody>
									for _, customer := range data.Customers.Items {
										<tr>
											<td data-label="Kunde"><strong>{ customerName(customer.FirstName, customer.LastName, customer.CompanyName) }</strong></td>
											<td data-label="Ort">{ fallback(customer.Locality) }</td>
											<td data-label="Region">{ fallback(customer.Region) }</td>
											<td data-label="Aufträge">{ fmt.Sprint(customer.JobCount) }</td>
											<td data-label="Aktion"><a class="button table-action" data-existing-customer-job href={ "/customers/" + customer.ID + "/jobs/new" }>Auftrag anlegen</a></td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					} else {
						<div class="empty-state compact-empty"><strong>Kein passender Kunde gefunden.</strong><p>Ändern Sie die Suche oder legen Sie oben eine neue Kundenakte an.</p></div>
					}
				</section>
			</main>@appFooter(data.Shell.Page)
		</body>
	</html>
}

templ CustomerDetail(data CustomerDetailData) {
	<!DOCTYPE html>
	<html lang="de-AT">
		@documentHead(data.Shell.Page, customerName(data.Detail.Customer.FirstName, data.Detail.Customer.LastName, data.Detail.Customer.CompanyName)+" – "+data.Shell.Page.AppName)
		<body>
			@appHeader(data.Shell)
			<main id="hauptinhalt" class="page compact-page customer-detail-page">
				<div class="page-heading customer-dossier-header">
					<div><p class="eyebrow">Kundenakte</p><h1>{ customerName(data.Detail.Customer.FirstName, data.Detail.Customer.LastName, data.Detail.Customer.CompanyName) }</h1><p>{ addressLine(data.Detail.Customer) }</p><small>Aktualisiert { customerLocalDateTime(data.Detail.Customer.UpdatedAt) }</small></div>
					<div class="action-row customer-dossier-actions">
						<button class="button button--quiet" type="button" data-copy-value={ addressLine(data.Detail.Customer) }>Adresse kopieren</button><button class="button button--quiet" type="button" data-print-page>Drucken</button>
						if data.Detail.MapsURL != "" {
							<a class="button button--quiet" href={ data.Detail.MapsURL } target="_blank" rel="noopener noreferrer">In Google Maps öffnen</a>
						}
						if data.Shell.Actor.Role == auth.RoleAdmin && data.Detail.Customer.ArchivedAt == nil {
							<form method="post" action={ "/customers/" + data.Detail.Customer.ID + "/archive" }><input type="hidden" name="csrf_token" value={ data.Shell.CSRFToken }/><input type="hidden" name="version" value={ fmt.Sprint(data.Detail.Customer.Version) }/><button class="button button--danger" type="submit" data-confirm-message={ customerName(data.Detail.Customer.FirstName, data.Detail.Customer.LastName, data.Detail.Customer.CompanyName) + " archivieren? Der Kunde verschwindet aus aktiven Ansichten; Aufträge und Historie bleiben erhalten. Aktive Planungsabläufe verhindern die Archivierung." }>Kunde archivieren</button></form>
						}
					</div>
				</div>
				if data.Detail.Customer.ArchivedAt != nil {
					<div class="form-alert form-alert--info">Dieser Kunde ist archiviert. Die Historie bleibt sichtbar.</div>
				}
				if data.Error != "" {
					<div class="form-alert" role="alert">{ data.Error }</div>
				}
				if len(data.Detail.Duplicates) > 0 {
					<section class="record-card" aria-labelledby="duplicate-heading">
						<div>
							<h2 id="duplicate-heading">Mögliche Dubletten vergleichen</h2>
							<div class="table-card compact-table-wrap">
								<table class="compact-table">
									<thead><tr><th>Kunde</th><th>Ort</th><th>Aktion</th></tr></thead>
									<tbody>
										for _, duplicate := range data.Detail.Duplicates {
											<tr><td>{ customerName(duplicate.FirstName, duplicate.LastName, duplicate.CompanyName) }</td><td>{ fallback(duplicate.Locality) }</td><td><form method="post" action={ "/recent/customers/" + duplicate.ID }><input type="hidden" name="csrf_token" value={ data.Shell.CSRFToken }/><button class="button button--quiet" type="submit">Vergleichsakte öffnen</button></form></td></tr>
										}
									</tbody>
								</table>
							</div>
							<p>Es wird nichts automatisch zusammengeführt.</p>
						</div>
					</section>
				}
				<section class="detail-grid customer-overview-grid">
					<article class="record-card customer-overview-card customer-contact-card">
						<div>
							<h2>Kontakt</h2>
							<dl class="profile-list customer-contact-list"><div><dt>Telefon</dt><dd>{ fallback(data.Detail.Customer.PhoneRaw) }</dd></div><div><dt>E-Mail</dt><dd>{ fallback(data.Detail.Customer.Email) }</dd></div><div><dt>Benachrichtigung</dt><dd>{ notificationPreferenceLabel(data.Detail.Customer.NotificationPreference) }</dd></div><div><dt>Standort</dt><dd>{ geocodingStatusLabel(data.Detail.Customer.GeocodingStatus) }</dd></div></dl>
							<div class="action-row">
								if customerPhoneURL(data.Detail.Customer.PhoneRaw) != "" {
									<a class="button" href={ customerPhoneURL(data.Detail.Customer.PhoneRaw) }>Anrufen</a>
								}
								if customerEmailURL(data.Detail.Customer.Email) != "" {
									<a class="button button--quiet" href={ customerEmailURL(data.Detail.Customer.Email) }>E-Mail</a>
								}
								if data.Detail.MapsURL != "" {
									<a class="button button--quiet" href={ data.Detail.MapsURL } target="_blank" rel="noopener noreferrer">Navigation</a>
								}
							</div>
						</div>
					</article>
					<article class="record-card customer-overview-card customer-history-card">
						<div>
							<div class="customer-card-heading"><h2>Terminhistorie</h2><label class="history-filter">Ereignistyp filtern<select data-history-filter><option value="">Alle Ereignisse</option><option value="proposal">Vorschläge</option><option value="fixed">Fixierte Termine</option><option value="completed">Erledigte Termine</option><option value="cancelled">Abgesagte Termine</option></select></label></div>
							if len(data.Detail.Appointments) == 0 {
								<p class="compact-empty-copy">Noch keine Termine angelegt.</p>
							} else {
								<ul class="history-list">
									for _, item := range data.Detail.Appointments {
										<li data-history-event={ customerAppointmentHistoryEvent(item) }><span><strong>{ item.JobNumber }</strong> · { customerLocalDateTime(item.StartsAt) }–{ customerLocalTime(item.EndsAt) }</span><span class="status-badge">{ customerAppointmentStatus(item) }</span></li>
									}
								</ul>
							}
						</div>
					</article>
				</section>
				if data.Detail.Customer.ArchivedAt == nil {
					@customerEditForm(data)
				}
				<section class="customer-orders-section">
					<div class="page-heading customer-orders-heading">
						<h2>Aufträge</h2>
						<div class="action-row">
							<span class="status-badge">{ fmt.Sprint(len(data.Detail.Jobs)) }</span>
							if data.Detail.Customer.ArchivedAt == nil {
								<a class="button button--quiet" href={ "/customers/" + data.Detail.Customer.ID + "/jobs/new" }>Weiteren Auftrag anlegen</a>
							}
						</div>
					</div>
					<div class="compact-job-list" aria-label="Aufträge dieses Kunden">
						<div class="compact-job-list__head" aria-hidden="true"><span>Auftrag</span><span>Leistung</span><span>Dauer</span><span>Wunsch</span><span>Status</span><span>Aktion</span></div>
						for _, job := range data.Detail.Jobs {
							<details class="compact-job-row" id={ "job-" + job.ID } data-record-id={ job.ID } open?={ data.JobEditID == job.ID }>
								<summary>
									<span class="compact-row__primary"><strong>{ job.JobNumber }</strong><small>{ fallback(job.Region) }</small></span>
									<span data-label="Leistung"><strong>{ job.VolumeM3 } m³</strong><small>{ jobTypeLabel(job.JobType) }</small></span>
									<span data-label="Dauer">{ durationLabel(job.EstimatedHackMinutes) }</span>
									<span data-label="Wunsch">{ preferredRangeLabel(job.PreferredStartDate, job.PreferredEndDate) }<small>{ urgencyLabel(job.Urgency) }</small></span>
									<span data-label="Status"><span class="status-badge">{ workflowLabel(job.WorkflowStatus) }</span></span>
									<span class="compact-row__action">{ jobActionLabel(job.WorkflowStatus, job.ArchivedAt != nil) }</span>
								</summary>
								<div class="compact-job-row__body">
									<div class="action-row job-primary-actions">
										<button class="button button--quiet" type="button" data-copy-value={ job.JobNumber }>Nummer kopieren</button>
										<form method="post" action="/waitlist/search"><input type="hidden" name="csrf_token" value={ data.Shell.CSRFToken }/><input type="hidden" name="q" value={ job.JobNumber }/><button class="button button--quiet" type="submit">In Warteliste fokussieren</button></form>
										if job.ActiveAppointmentID != "" {
											<a class="button button--quiet" href={ "/calendar?appointment=" + url.QueryEscape(job.ActiveAppointmentID) }>Blockierenden Termin öffnen</a>
										}
										<details class="row-actions job-more-actions">
											<summary>Weitere Aktionen</summary>
											<div><a class="button button--quiet" href={ "/jobs/" + job.ID + "/duplicate" }>Als neuen Entwurf duplizieren</a><form method="post" action={ "/recent/jobs/" + job.ID }><input type="hidden" name="csrf_token" value={ data.Shell.CSRFToken }/><button class="button button--quiet" type="submit">Als zuletzt geöffnet merken</button></form></div>
										</details>
									</div>
									if job.ArchivedAt == nil && jobWorkflowEditable(job.WorkflowStatus) {
										<form method="post" action={ "/jobs/" + job.ID } class="compact-form job-workbench-form customer-job-edit-form" data-transport-form data-track-change data-record-id={ job.ID } data-sticky-actions>
											if data.JobEditID == job.ID && data.JobEditError != "" {
												<div id={ "job-edit-error-" + job.ID } class="form-alert" role="alert" tabindex="-1" autofocus>
													<strong>Auftrag konnte nicht gespeichert werden.</strong>
													<p>{ data.JobEditError }</p>
													if data.JobConflict {
														<a class="button button--quiet" href={ "/customers/" + data.Detail.Customer.ID + "#job-" + job.ID }>Aktuellen Stand neu laden</a>
													}
												</div>
											}
											if job.WorkflowStatus == "scheduled" {
												<div class="form-hint"><strong>Termin bleibt unverändert:</strong> Terminzeit, Fahrer und Ressourcen werden ausschließlich im Kalender durch einen Administrator geändert. Änderungen an Typ oder Menge machen eine frühere Kundenbestätigung ungültig.</div>
											}
											<input type="hidden" name="csrf_token" value={ data.Shell.CSRFToken }/><input type="hidden" name="customer_id" value={ data.Detail.Customer.ID }/><input type="hidden" name="version" value={ jobEditVersion(data, job) }/><input type="hidden" name="transport_mode" value="none" data-transport-default disabled/>
											<fieldset class="compact-form-section job-form-section job-core-section">
												<legend>Hackauftrag</legend>
												<div class="job-core-grid">
													<label class="compact-field">
														Typ<select name="job_type" data-job-type aria-invalid={ formFieldInvalid(jobEditErrorsFor(data, job), "job_type") } aria-describedby={ formFieldDescription(jobEditErrorsFor(data, job), "job_type") }><option value="chipping_only" selected?={ jobEditValuesFor(data, job).JobType == "chipping_only" }>Nur Hackmaschine</option><option value="chipping_with_transport" selected?={ jobEditValuesFor(data, job).JobType == "chipping_with_transport" }>Mit Transport</option></select>@formFieldMessage(jobEditErrorsFor(data, job), "job_type")
													</label>
													<label class="compact-field">
														Menge in m³<span class="compact-control-with-tools"><input name="volume_m3" inputmode="decimal" value={ jobEditValuesFor(data, job).Volume } required data-volume-input aria-invalid={ formFieldInvalid(jobEditErrorsFor(data, job), "volume_m3") } aria-describedby={ formFieldDescription(jobEditErrorsFor(data, job), "volume_m3") }/><span class="compact-field-tools"><button class="button button--quiet" type="button" data-volume-preset="30">30</button><button class="button button--quiet" type="button" data-volume-preset="50">50</button><button class="button button--quiet" type="button" data-volume-preset="100">100</button></span></span>@formFieldMessage(jobEditErrorsFor(data, job), "volume_m3")
													</label>
													<label class="compact-field">
														Hackdauer<span class="compact-control-with-tools"><input name="hack_duration" value={ jobEditValuesFor(data, job).HackDuration } required data-duration-input="hack" aria-invalid={ formFieldInvalid(jobEditErrorsFor(data, job), "hack_duration") } aria-describedby={ formFieldDescription(jobEditErrorsFor(data, job), "hack_duration") }/><span class="compact-field-tools"><button class="button button--quiet" type="button" data-duration-adjust="-15" data-duration-target="hack">−15</button><button class="button button--quiet" type="button" data-duration-adjust="15" data-duration-target="hack">+15</button></span></span>@formFieldMessage(jobEditErrorsFor(data, job), "hack_duration")
													</label>
													<p class="form-hint job-duration-summary" data-job-duration-summary>Gesamtdauer wird aus Hack- und Transportdauer berechnet.</p>
													<div class="job-transport-grid" data-transport-field>
														<label class="compact-field">
															Transportdauer<span class="compact-control-with-tools"><input name="transport_duration" value={ jobEditValuesFor(data, job).TransportDuration } data-transport-control data-duration-input="transport" aria-invalid={ formFieldInvalid(jobEditErrorsFor(data, job), "transport_duration") } aria-describedby={ formFieldDescription(jobEditErrorsFor(data, job), "transport_duration") }/><span class="compact-field-tools"><button class="button button--quiet" type="button" data-duration-adjust="-15" data-duration-target="transport">−15</button><button class="button button--quiet" type="button" data-duration-adjust="15" data-duration-target="transport">+15</button></span></span>@formFieldMessage(jobEditErrorsFor(data, job), "transport_duration")
														</label>
														<label class="compact-field">
															Fahrten<input name="transport_trips" type="number" min="0" max="1000" value={ jobEditValuesFor(data, job).Trips } data-transport-control aria-invalid={ formFieldInvalid(jobEditErrorsFor(data, job), "transport_trips") } aria-describedby={ formFieldDescription(jobEditErrorsFor(data, job), "transport_trips") }/>@formFieldMessage(jobEditErrorsFor(data, job), "transport_trips")
														</label>
														<label class="compact-field">
															Transportmodus<select name="transport_mode" data-transport-control data-transport-mode aria-invalid={ formFieldInvalid(jobEditErrorsFor(data, job), "transport_mode") } aria-describedby={ formFieldDescription(jobEditErrorsFor(data, job), "transport_mode") }><option value="none" selected?={ jobEditValuesFor(data, job).TransportMode == "none" }>Kein Transport</option><option value="undecided" selected?={ jobEditValuesFor(data, job).TransportMode == "undecided" }>Noch offen</option><option value="internal" selected?={ jobEditValuesFor(data, job).TransportMode == "internal" }>Intern</option><option value="external" selected?={ jobEditValuesFor(data, job).TransportMode == "external" }>Extern</option></select>@formFieldMessage(jobEditErrorsFor(data, job), "transport_mode")
														</label>
														<div class="compact-check-field" data-external-confirmation>
															<label class="check-label"><input name="external_confirmed" type="checkbox" value="true" checked?={ jobEditValuesFor(data, job).ExternalConfirmed } aria-invalid={ formFieldInvalid(jobEditErrorsFor(data, job), "external_confirmed") } aria-describedby={ formFieldDescription(jobEditErrorsFor(data, job), "external_confirmed") }/> Externer Transport bestätigt</label>@formFieldMessage(jobEditErrorsFor(data, job), "external_confirmed")
														</div>
													</div>
												</div>
											</fieldset>
											<fieldset class="compact-form-section job-form-section job-preference-section">
												<legend>Wunsch &amp; Warteliste</legend>
												<div class="job-preference-grid">
													<label class="compact-field">Terminpräferenz<select name="preference_mode" required><option value="window" selected?={ jobEditValuesFor(data, job).PreferenceMode == "window" }>Zeitraum</option><option value="fixed" selected?={ jobEditValuesFor(data, job).PreferenceMode == "fixed" }>Fixes Datum</option><option value="flexible" selected?={ jobEditValuesFor(data, job).PreferenceMode == "flexible" }>Flexibel</option></select></label>
													<label class="compact-field">
														Frühestes Datum<input name="preferred_start" type="date" value={ jobEditValuesFor(data, job).PreferredStart } data-date-range-start aria-invalid={ formFieldInvalid(jobEditErrorsFor(data, job), "preferred_start") } aria-describedby={ formFieldDescription(jobEditErrorsFor(data, job), "preferred_start") }/>@formFieldMessage(jobEditErrorsFor(data, job), "preferred_start")
													</label>
													<label class="compact-field">
														Spätestes Datum<input name="preferred_end" type="date" value={ jobEditValuesFor(data, job).PreferredEnd } data-date-range-end aria-invalid={ formFieldInvalid(jobEditErrorsFor(data, job), "preferred_end") } aria-describedby={ formFieldDescription(jobEditErrorsFor(data, job), "preferred_end") }/>@formFieldMessage(jobEditErrorsFor(data, job), "preferred_end")
													</label>
													<label class="compact-field">Dringlichkeit<select name="urgency"><option value="low" selected?={ jobEditValuesFor(data, job).Urgency == "low" }>Niedrig</option><option value="normal" selected?={ jobEditValuesFor(data, job).Urgency == "normal" }>Normal</option><option value="high" selected?={ jobEditValuesFor(data, job).Urgency == "high" }>Hoch</option><option value="urgent" selected?={ jobEditValuesFor(data, job).Urgency == "urgent" }>Dringend</option></select></label>
													<label class="compact-field">Region<input name="region" value={ jobEditValuesFor(data, job).Region }/></label>
													<label class="compact-field">Quelle<select name="source"><option value="phone" selected?={ jobEditValuesFor(data, job).Source == "phone" }>Telefon</option><option value="email" selected?={ jobEditValuesFor(data, job).Source == "email" }>E-Mail</option><option value="in_person" selected?={ jobEditValuesFor(data, job).Source == "in_person" }>Persönlich</option><option value="other" selected?={ jobEditValuesFor(data, job).Source == "other" }>Sonstige</option></select></label>
													<div class="compact-field-tools job-date-presets"><button class="button button--quiet" type="button" data-date-range-preset data-start-offset="0" data-day-span="7">Diese Woche</button><button class="button button--quiet" type="button" data-date-range-preset data-start-offset="7" data-day-span="7">Nächste Woche</button><button class="button button--quiet" type="button" data-date-range-preset data-start-offset="0" data-day-span="30">30 Tage</button></div>
												</div>
											</fieldset>
											<details class="form-disclosure job-additional-disclosure" open?={ jobAdditionalOpen(jobEditValuesFor(data, job), jobEditErrorsFor(data, job)) }>
												<summary><span>Zusätzliche Angaben</span><small>Wunschtext</small></summary>
												<div class="form-disclosure__body"><label>Wunsch als Freitext<textarea name="preference_text">{ jobEditValuesFor(data, job).PreferenceText }</textarea></label></div>
											</details>
											<details class="form-disclosure job-location-disclosure" open?={ jobLocationOpen(jobEditValuesFor(data, job), jobEditErrorsFor(data, job)) }>
												<summary><span>Haufenstandort</span><span class="status-badge">{ locationBadge(jobEditValuesFor(data, job)) }</span></summary>
												<div class="form-disclosure__body">
													@jobLocationEditor(data.Shell.Page, "edit-"+job.ID, jobEditValuesFor(data, job), coordinateValue(data.Detail.Customer.Latitude), coordinateValue(data.Detail.Customer.Longitude), customerAddress(data.Detail.Customer), jobEditErrorsFor(data, job))
												</div>
											</details>
											<div class="form-actions workbench-form-actions"><a class="button button--quiet" href={ "/customers/" + data.Detail.Customer.ID + "#job-" + job.ID }>Abbrechen</a><button class="button" type="submit">Auftrag speichern</button></div>
										</form>
										if data.Shell.Actor.Role == auth.RoleAdmin && (job.WorkflowStatus == "waitlist" || job.WorkflowStatus == "planning") {
											<form method="post" action={ "/jobs/" + job.ID + "/archive" } class="compact-danger" data-confirm-message={ "Auftrag " + job.JobNumber + " archivieren? Er wird aus der aktiven Planung entfernt; seine Historie bleibt erhalten." }><input type="hidden" name="csrf_token" value={ data.Shell.CSRFToken }/><input type="hidden" name="customer_id" value={ data.Detail.Customer.ID }/><input type="hidden" name="version" value={ fmt.Sprint(job.Version) }/><button class="button button--danger" type="submit">Auftrag archivieren</button></form>
										}
									} else {
										<div class="form-hint">Dieser Auftrag ist im Status „{ workflowLabel(job.WorkflowStatus) }“ schreibgeschützt. Die Historie bleibt sichtbar.</div>
										@jobLocationPreview(data.Shell.Page, job)
									}
									<details class="notes compact-notes" id={ "notes-" + job.ID }>
										<summary>Interne Bemerkungen ({ fmt.Sprint(len(data.Detail.Notes[job.ID])) })</summary>
										for _, note := range data.Detail.Notes[job.ID] {
											<blockquote><p>{ note.Body }</p><footer>{ note.AuthorName } · { customerLocalDateTime(note.CreatedAt) }</footer></blockquote>
										}
										<form method="post" action={ "/jobs/" + job.ID + "/notes" } class="inline-note"><input type="hidden" name="csrf_token" value={ data.Shell.CSRFToken }/><input type="hidden" name="customer_id" value={ data.Detail.Customer.ID }/><input type="hidden" name="idempotency_key" value={ data.Detail.PageRequestID + ":" + job.ID }/><label><span>Bemerkung ergänzen</span><textarea name="body" maxlength="4000" required data-note-input></textarea><small data-character-count>0 / 4000</small><span class="action-row"><button class="button button--quiet" type="button" data-note-template="Rückruf erbeten. ">Rückruf</button><button class="button button--quiet" type="button" data-note-template="Zufahrt vorab prüfen. ">Zufahrt</button></span></label><button class="button button--quiet" type="submit">Hinzufügen</button></form>
									</details>
								</div>
							</details>
						}
					</div>
				</section>
			</main>@appFooter(data.Shell.Page)
		</body>
	</html>
}

templ customerEditForm(data CustomerDetailData) {
	<details class="edit-card customer-edit-card" open?={ data.OpenCustomerEdit }>
		<summary><span>Kundendaten bearbeiten</span><small>Identität, Adresse und Kontakt</small></summary>
		<form method="post" action={ "/customers/" + data.Detail.Customer.ID } class="customer-record-form" data-track-change data-record-id={ data.Detail.Customer.ID } data-sticky-actions>
			<input type="hidden" name="csrf_token" value={ data.Shell.CSRFToken }/><input type="hidden" name="version" value={ customerEditVersion(data) }/>
			if data.CustomerEditError != "" {
				<div id="customer-edit-error" class="form-alert" role="alert" tabindex="-1" autofocus>
					<strong>Kundendaten konnten nicht gespeichert werden.</strong>
					<p>{ data.CustomerEditError }</p>
					if data.CustomerConflict {
						<a class="button button--quiet" href={ "/customers/" + data.Detail.Customer.ID }>Aktuellen Stand neu laden</a>
					}
				</div>
			}
			@customerFormFields(customerEditValuesFor(data), data.CustomerFieldErrors)
			<div class="form-actions workbench-form-actions"><a class="button button--quiet" href={ "/customers/" + data.Detail.Customer.ID }>Abbrechen</a><button class="button" type="submit">Änderungen speichern</button></div>
		</form>
	</details>
}

func customerEditValuesFor(data CustomerDetailData) IntakeValues {
	if data.OpenCustomerEdit {
		return data.CustomerValues
	}
	return IntakeValues{
		FirstName: data.Detail.Customer.FirstName, LastName: data.Detail.Customer.LastName, CompanyName: data.Detail.Customer.CompanyName,
		Street: data.Detail.Customer.Street, PostalCode: data.Detail.Customer.PostalCode, Locality: data.Detail.Customer.Locality,
		Region: data.Detail.Customer.Region, AddressFreeform: data.Detail.Customer.AddressFreeform, Phone: data.Detail.Customer.PhoneRaw,
		Email: data.Detail.Customer.Email, Notification: string(data.Detail.Customer.NotificationPreference),
	}
}

func customerEditVersion(data CustomerDetailData) string {
	if data.CustomerVersion != "" {
		return data.CustomerVersion
	}
	return fmt.Sprint(data.Detail.Customer.Version)
}

func jobEditValuesFor(data CustomerDetailData, job customers.Job) IntakeValues {
	if data.JobEditID == job.ID {
		return data.JobValues
	}
	values := IntakeValues{
		JobType: string(job.JobType), Volume: job.VolumeM3, HackDuration: durationInput(job.EstimatedHackMinutes),
		TransportDuration: optionalDurationInput(job.EstimatedTransportMinutes), Trips: fmt.Sprint(job.TransportTripCount),
		TransportMode: string(job.TransportMode), PreferredStart: job.PreferredStartDate, PreferredEnd: job.PreferredEndDate,
		PreferenceMode: string(job.PreferenceMode),
		PreferenceText: job.PreferenceText, Urgency: string(job.Urgency), Region: job.Region, Source: string(job.Source),
		ExternalConfirmed: job.ExternalTransportConfirmed, PileLocationSource: string(job.PileLocationSource),
	}
	if job.TransportTripCount == 0 {
		values.Trips = "0"
	}
	values.PileLatitude = coordinateValue(job.PileLatitude)
	values.PileLongitude = coordinateValue(job.PileLongitude)
	return values
}

func jobEditErrorsFor(data CustomerDetailData, job customers.Job) []FormFieldError {
	if data.JobEditID == job.ID {
		return data.JobFieldErrors
	}
	return nil
}

func jobEditVersion(data CustomerDetailData, job customers.Job) string {
	if data.JobEditID == job.ID && data.JobVersion != "" {
		return data.JobVersion
	}
	return fmt.Sprint(job.Version)
}

func customerLocalDateTime(value time.Time) string {
	return value.In(viennaLocation()).Format("02.01.2006 15:04")
}
func customerLocalTime(value time.Time) string { return value.In(viennaLocation()).Format("15:04") }
func preferredRangeLabel(start string, end string) string {
	if start == "" && end == "" {
		return "Kein Zeitraum"
	}
	if start == "" {
		return "bis " + customerDate(end)
	}
	if end == "" {
		return "ab " + customerDate(start)
	}
	return customerDate(start) + " – " + customerDate(end)
}
func customerDate(value string) string {
	parsed, err := time.Parse(time.DateOnly, value)
	if err != nil {
		return value
	}
	return parsed.Format("02.01.2006")
}
func jobActionLabel(workflow string, archived bool) string {
	if !archived && jobWorkflowEditable(workflow) {
		return "Öffnen & bearbeiten"
	}
	return "Details öffnen"
}

func jobWorkflowEditable(workflow string) bool {
	return workflow == "waitlist" || workflow == "planning" || workflow == "scheduled"
}
func customerAppointmentStatus(value customers.AppointmentHistory) string {
	switch value.Lifecycle {
	case "draft", "proposal":
		return "Vorschlag"
	case "completed":
		return "Erledigt"
	case "cancelled":
		return "Abgesagt"
	}
	switch value.Confirmation {
	case "confirmed":
		return "Bestätigt"
	case "declined":
		return "Abgelehnt"
	case "callback_requested":
		return "Rückruf"
	default:
		return "Fixiert – offen"
	}
}

func customerAppointmentHistoryEvent(value customers.AppointmentHistory) string {
	if value.Lifecycle == "draft" {
		return "proposal"
	}
	return value.Lifecycle
}

templ JobForm(data JobFormData) {
	<!DOCTYPE html>
	<html lang="de-AT">
		@documentHead(data.Shell.Page, "Weiterer Auftrag – "+data.Shell.Page.AppName)
		<body>
			@appHeader(data.Shell)
			<main id="hauptinhalt" class="page compact-page customer-job-form-page">
				<div class="page-heading"><div><p class="eyebrow">Bestehender Kunde</p><h1>Auftrag für { data.CustomerName }</h1></div><a class="button button--quiet" href={ "/customers/" + data.CustomerID }>Abbrechen</a></div>
				@formErrorSummary(data.Error, data.FieldErrors)
				<form method="post" action={ "/customers/" + data.CustomerID + "/jobs" } class="intake-form customer-job-workbench" data-transport-form data-sticky-actions>
					<input type="hidden" name="csrf_token" value={ data.Shell.CSRFToken }/><input type="hidden" name="transport_mode" value="none" data-transport-default disabled/>
					@jobIntakeFields(data.Shell.Page, "new-customer-job", data.Values, data.FieldErrors, data.CustomerLatitude, data.CustomerLongitude, data.CustomerAddress, data.CustomerRegion)
					<div class="form-actions workbench-form-actions"><a class="button button--quiet" href={ "/customers/" + data.CustomerID }>Abbrechen</a><button class="button" type="submit">Auf Warteliste setzen</button></div>
				</form>
			</main>@appFooter(data.Shell.Page)
		</body>
	</html>
}

templ Waitlist(data WaitlistData) {
	<!DOCTYPE html>
	<html lang="de-AT">
		@documentHead(data.Shell.Page, fmt.Sprintf("%d Treffer – Warteliste – %s", data.Page.Total, data.Shell.Page.AppName))
		<body>
			@appHeader(data.Shell)
			<main id="hauptinhalt" class="page compact-page waitlist-page">
				<div class="page-heading"><div><p class="eyebrow">Arbeitsvorrat</p><h1>Warteliste</h1><p>Kompakte Dispositionsansicht. Die Position bleibt relativ zu Filtern, Priorität und Sortierung.</p></div><a class="button mobile-redundant-primary-action" href="/customers/new">Neuen Auftrag erfassen</a></div>
				if data.Error != "" {
					<div class="form-alert" role="alert">{ data.Error }</div>
				}
				<form id="waitlist-list-controls" method="post" action="/waitlist/search" class="customer-list-toolbar waitlist-list-toolbar">
					<input type="hidden" name="csrf_token" value={ data.Shell.CSRFToken }/><input type="hidden" name="sort" value={ data.Filter.Sort }/><input type="hidden" name="direction" value={ data.Filter.Direction }/>
					<div class="customer-list-toolbar__search">
						<label for="waitlist-search" class="visually-hidden">Warteliste durchsuchen</label>
						<input id="waitlist-search" name="q" type="search" value={ data.Filter.Query } placeholder="Kunde, Firma, Ort, Region oder Auftragsnummer" autocomplete="off" data-primary-search/>
						<output class="customer-result-count" for="waitlist-search">{ fmt.Sprint(data.Page.Total) } von { fmt.Sprint(data.Page.UnfilteredTotal) } Aufträgen</output>
						<button class="button button--quiet" type="submit">Suchen</button>
						<a class="button button--quiet" href="/waitlist">Zurücksetzen</a>
					</div>
					<div class="list-sort-controls" role="group" aria-label="Warteliste sortieren">
						<label>Sortieren nach<select name="sort_choice"><option value="entered" selected?={ data.Filter.Sort == "entered" }>Eingang</option><option value="preferred" selected?={ data.Filter.Sort == "preferred" }>Wunschzeitraum</option><option value="urgency" selected?={ data.Filter.Sort == "urgency" }>Dringlichkeit</option><option value="volume" selected?={ data.Filter.Sort == "volume" }>Holzmenge</option><option value="duration" selected?={ data.Filter.Sort == "duration" }>Gesamtdauer</option><option value="region" selected?={ data.Filter.Sort == "region" }>Region</option><option value="customer" selected?={ data.Filter.Sort == "customer" }>Kunde</option><option value="workflow" selected?={ data.Filter.Sort == "workflow" }>Planungsstand</option><option value="updated" selected?={ data.Filter.Sort == "updated" }>Zuletzt geändert</option></select></label>
						<label>Richtung<select name="direction_choice"><option value="asc" selected?={ data.Filter.Direction == "asc" }>Aufsteigend</option><option value="desc" selected?={ data.Filter.Direction == "desc" }>Absteigend</option></select></label>
						<button class="button button--quiet" type="submit">Sortieren</button>
					</div>
					<details class="customer-filter-menu waitlist-filter-menu" open?={ waitlistFilterCount(data.Filter) > 0 }>
						<summary>Filter <span class="customer-filter-count">{ fmt.Sprint(waitlistFilterCount(data.Filter)) }</span></summary>
						<div class="customer-filter-menu__panel waitlist-filter-menu__panel">
							<div class="customer-filter-grid waitlist-filter-grid">
								<label>Typ<select name="type"><option value="">Alle</option><option value="chipping_only" selected?={ data.Filter.JobType == "chipping_only" }>Nur Hackmaschine</option><option value="chipping_with_transport" selected?={ data.Filter.JobType == "chipping_with_transport" }>Mit Transport</option></select></label>
								<label>Region<input name="region" value={ data.Filter.Region } placeholder="Region filtern"/></label>
								<label>Dringlichkeit<select name="urgency"><option value="">Alle</option><option value="low" selected?={ data.Filter.Urgency == "low" }>Niedrig</option><option value="normal" selected?={ data.Filter.Urgency == "normal" }>Normal</option><option value="high" selected?={ data.Filter.Urgency == "high" }>Hoch</option><option value="urgent" selected?={ data.Filter.Urgency == "urgent" }>Dringend</option></select></label>
								<label>Planungsstand<select name="workflow"><option value="">Alle</option><option value="unplanned" selected?={ data.Filter.Workflow == "unplanned" }>Ungeplant</option><option value="proposal" selected?={ data.Filter.Workflow == "proposal" }>Vorschlag</option><option value="scheduled" selected?={ data.Filter.Workflow == "scheduled" }>Eingeplant</option></select></label>
								<label>Wunschmonat<input name="month" type="month" value={ data.Filter.PreferredMonth }/></label>
								<label>Dauergruppe<select name="duration_group"><option value="">Alle</option><option value="short" selected?={ data.Filter.DurationGroup == "short" }>bis 2 Stunden</option><option value="medium" selected?={ data.Filter.DurationGroup == "medium" }>2–6 Stunden</option><option value="long" selected?={ data.Filter.DurationGroup == "long" }>über 6 Stunden</option></select></label>
								<label class="customer-filter-chip"><input name="incomplete" type="checkbox" value="1" checked?={ data.Filter.Incomplete }/> Prüfwarteschlange: unvollständig</label>
								<label class="customer-filter-chip"><input name="missing_location" type="checkbox" value="1" checked?={ data.Filter.MissingLocation }/> Haufenstandort fehlt</label>
								<label class="customer-filter-chip"><input name="duration_issue" type="checkbox" value="1" checked?={ data.Filter.DurationIssue }/> Dauer prüfen</label>
								<label class="customer-filter-chip"><input name="overdue" type="checkbox" value="1" checked?={ data.Filter.Overdue }/> Wunschzeitraum überfällig</label>
								<label class="customer-filter-chip"><input name="unassigned" type="checkbox" value="1" checked?={ data.Filter.Unassigned }/> Ohne interne Zuständigkeit</label>
								<label class="customer-filter-chip"><input name="transport_pending" type="checkbox" value="1" checked?={ data.Filter.TransportPending }/> Transport unbestätigt</label>
							</div>
							<div class="customer-filter-actions"><button class="button" type="submit">Filter anwenden</button><a class="button button--quiet" href="/waitlist">Alle zurücksetzen</a></div>
						</div>
					</details>
				</form>
				if waitlistHasFilters(data.Filter) {
					<div class="action-row waitlist-filter-chips" aria-label="Aktive Filter">
						<span class="status-badge">Aktive Filter</span>
						if data.Filter.JobType != "" {
							@waitlistFilterChip(data, "type", "Typ")
						}
						if data.Filter.Region != "" {
							@waitlistFilterChip(data, "region", "Region")
						}
						if data.Filter.Urgency != "" {
							@waitlistFilterChip(data, "urgency", "Dringlichkeit")
						}
						if data.Filter.PreferredMonth != "" {
							@waitlistFilterChip(data, "month", "Wunschmonat")
						}
						if data.Filter.Workflow != "" {
							@waitlistFilterChip(data, "workflow", "Planungsstand")
						}
						if data.Filter.DurationGroup != "" {
							@waitlistFilterChip(data, "duration_group", "Dauergruppe")
						}
						if data.Filter.MissingLocation {
							@waitlistFilterChip(data, "missing_location", "Standort fehlt")
						}
						if data.Filter.DurationIssue {
							@waitlistFilterChip(data, "duration_issue", "Dauer prüfen")
						}
						if data.Filter.Overdue {
							@waitlistFilterChip(data, "overdue", "Überfällig")
						}
						if data.Filter.Unassigned {
							@waitlistFilterChip(data, "unassigned", "Ohne Zuständigkeit")
						}
						if data.Filter.TransportPending {
							@waitlistFilterChip(data, "transport_pending", "Transport unbestätigt")
						}
						if data.Filter.Incomplete {
							@waitlistFilterChip(data, "incomplete", "Prüfwarteschlange")
						}
					</div>
				}
				<details class="compact-filter-panel waitlist-saved-views">
					<summary>Regionen &amp; Filterfavoriten</summary>
					<div class="waitlist-saved-views__body">
						if len(waitlistRegions(data.Page.Items)) > 0 {
							<div class="action-row waitlist-regions" aria-label="Häufige Regionen">
								<span>Regionen:</span>
								for _, region := range waitlistRegions(data.Page.Items) {
									<form method="post" action="/waitlist/search">
										<input type="hidden" name="csrf_token" value={ data.Shell.CSRFToken }/>@waitlistSearchHiddenFields(data.Filter)
										<button class="button button--quiet" type="submit" name="region_choice" value={ region }>{ region }</button>
									</form>
								}
							</div>
						}
						<div class="action-row waitlist-favorites" aria-label="Filterfavoriten">
							for _, favorite := range data.Page.Favorites {
								<a class="button button--quiet" href={ "/waitlist?" + waitlistQuery(favorite.Filter) }>{ favorite.Name }</a>
								<form method="post" action={ "/waitlist/filter-favorites/" + favorite.ID + "/delete" }><input type="hidden" name="csrf_token" value={ data.Shell.CSRFToken }/><button class="button button--quiet" type="submit" aria-label={ "Filterfavorit " + favorite.Name + " löschen" }>×</button></form>
							}
						</div>
						<form method="post" action="/waitlist/filter-favorites" class="filter-bar compact-filter waitlist-save-filter">
							<input type="hidden" name="csrf_token" value={ data.Shell.CSRFToken }/>@waitlistHiddenFilter(data.Filter)
							<label>Aktuelle Filter speichern<input name="name" maxlength="60" required placeholder="z. B. Region Nord"/></label><button class="button button--quiet" type="submit">Als Favorit speichern</button>
						</form>
					</div>
				</details>
				if len(data.Page.Items) > 0 {
					<div class="action-row selection-toolbar" data-waitlist-selection-toolbar><strong data-selection-count>0 ausgewählt</strong><button class="button button--quiet" type="button" data-selection-open disabled>Ausgewählte Aufträge nacheinander öffnen</button><small>Maximal 20; keine Termine werden fixiert, abgesagt oder benachrichtigt.</small></div>
					<div class="table-card compact-table-wrap">
						<table class="compact-table responsive-table waitlist-table">
							<caption class="visually-hidden">Warteliste mit Auftrag, Kunde, Menge, Dauer, Wunsch, Planungsreife und Aktionen.</caption>
							<thead><tr><th>Auswahl</th><th aria-sort={ waitlistAriaSort(data.Filter, "entered") }><button class={ waitlistTableSortClass(data.Filter, "entered") } type="submit" name="order" value={ waitlistSortOrder(data.Filter, "entered") } form="waitlist-list-controls">Auftrag { waitlistSortMark(data.Filter, "entered") }</button></th><th aria-sort={ waitlistAriaSort(data.Filter, "customer") }><button class={ waitlistTableSortClass(data.Filter, "customer") } type="submit" name="order" value={ waitlistSortOrder(data.Filter, "customer") } form="waitlist-list-controls">Kunde { waitlistSortMark(data.Filter, "customer") }</button></th><th aria-sort={ waitlistAriaSort(data.Filter, "volume") }><button class={ waitlistTableSortClass(data.Filter, "volume") } type="submit" name="order" value={ waitlistSortOrder(data.Filter, "volume") } form="waitlist-list-controls">Menge / Dauer { waitlistSortMark(data.Filter, "volume") }</button></th><th aria-sort={ waitlistAriaSort(data.Filter, "region") }><button class={ waitlistTableSortClass(data.Filter, "region") } type="submit" name="order" value={ waitlistSortOrder(data.Filter, "region") } form="waitlist-list-controls">Region / Wunsch { waitlistSortMark(data.Filter, "region") }</button></th><th aria-sort={ waitlistAriaSort(data.Filter, "workflow") }><button class={ waitlistTableSortClass(data.Filter, "workflow") } type="submit" name="order" value={ waitlistSortOrder(data.Filter, "workflow") } form="waitlist-list-controls">Nächster Schritt { waitlistSortMark(data.Filter, "workflow") }</button></th><th>Reife / Prio</th><th>Aktionen</th></tr></thead>
							<tbody>
								for _, item := range data.Page.Items {
									<tr data-job-id={ item.JobID } data-record-id={ item.JobID }>
										<td data-label="Auswahl"><label class="waitlist-select-control"><input type="checkbox" aria-label={ item.JobNumber + " auswählen" } data-waitlist-select data-open-href={ "/customers/" + item.CustomerID + "#job-" + item.JobID }/></label></td>
										<td data-label="Auftrag">
											<span class="waitlist-job-number">
												<strong>{ item.JobNumber }</strong>
												<button class="button waitlist-copy-button" type="button" data-copy-value={ item.JobNumber } data-copy-icon aria-label={ "Auftragsnummer " + item.JobNumber + " kopieren" } title="Auftragsnummer kopieren">
													<svg class="copy-icon copy-icon--default" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
														<rect x="8" y="8" width="12" height="12" rx="2"></rect>
														<path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path>
													</svg>
													<svg class="copy-icon copy-icon--success" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
														<path d="m5 12.5 4.2 4.2L19 7"></path>
													</svg>
												</button>
											</span>
											<small>Eingang { item.EnteredAt.In(viennaLocation()).Format("02.01.2006") } · { ageLabel(item.AgeDays) }</small><small>Geändert { customerLocalDateTime(item.UpdatedAt) }</small>
										</td>
										<td data-label="Kunde">
											<a href={ "/customers/" + item.CustomerID + "#job-" + item.JobID }><strong>{ customerName(item.FirstName,item.LastName,item.CompanyName) }</strong></a>
											if item.NoteExcerpt != "" {
												<small>{ item.NoteExcerpt }</small>
											}
										</td>
										<td data-label="Menge / Dauer">
											<strong>{ item.VolumeM3 } m³ · { durationLabel(item.TotalMinutes) }</strong><small>Hacken { durationLabel(item.EstimatedHackMinutes) } · Transport { durationLabel(item.EstimatedTransportMinutes) } · { jobTypeLabel(item.JobType) }</small>
											if item.DurationIssue {
												<span class="status-badge">Dauer prüfen</span>
											}
											if !item.HasPileSource {
												<span class="status-badge">Haufenadresse/Standortquelle fehlt</span>
											} else if !item.HasPileLocation {
												<span class="status-badge">Koordinaten fehlen</span>
											}
										</td>
										<td data-label="Region / Wunsch">
											{ fallback(item.Region) }<small>{ preferredRangeLabel(item.PreferredStartDate, item.PreferredEndDate) } · { fallback(item.PreferenceText) }</small>
											if item.Overdue {
												<span class="status-badge status-badge--failed">Wunschzeitraum überfällig</span>
											}
										</td>
										<td data-label="Nächster Schritt">
											<strong>{ item.NextStep }</strong><small>{ urgencyLabel(item.Urgency) } · { workflowFilterLabel(item.WorkflowStatus) } · { preferenceModeLabel(item.PreferenceMode) }</small>
											if len(item.MissingFields) > 0 {
												<ul class="compact-check-list">
													for _, missing := range item.MissingFields {
														<li><a href={ "/customers/" + item.CustomerID + "#job-" + item.JobID }>{ missing }</a></li>
													}
												</ul>
											}
										</td>
										<td data-label="Reife / Prio">
											<strong>{ fmt.Sprint(item.Completeness) } %</strong><progress max="100" value={ fmt.Sprint(item.Completeness) } aria-label={ fmt.Sprintf("Vollständigkeit %d Prozent", item.Completeness) }></progress><small>Priorität { fmt.Sprint(item.ManualPriority) }</small>
											if item.PriorityReason != "" {
												<small>Grund: { item.PriorityReason }</small>
											}
											if item.PlanReady {
												<span class="status-badge status-badge--success">Planungsbereit</span>
											}
										</td>
										<td data-label="Aktionen">
											<div class="table-row-actions">
												if data.Shell.Actor.Role == auth.RoleAdmin {
													<a class="button" href={ "/calendar/plan?job_id=" + url.QueryEscape(item.JobID) }>Einplanen</a>
												} else {
													<a class="button button--quiet" href={ "/customers/" + item.CustomerID + "#job-" + item.JobID }>Bearbeiten</a>
												}
												<details class="row-actions">
													<summary aria-label={ "Weitere Aktionen für " + item.JobNumber }>Mehr</summary>
													<div>
														<a class="button button--quiet" href={ "/customers/" + item.CustomerID + "#job-" + item.JobID }>Auftrag bearbeiten</a>
														if data.Shell.Actor.Role == auth.RoleAdmin {
															<a class="button button--quiet" href={ "/planning?job_id=" + url.QueryEscape(item.JobID) + "&return_to=" + url.QueryEscape("/waitlist?"+waitlistQuery(data.Filter)) }>Vorschläge</a>
															<form method="post" action={ "/waitlist/" + item.WaitlistID + "/priority" } class="inline-form compact-priority"><input type="hidden" name="csrf_token" value={ data.Shell.CSRFToken }/><input type="hidden" name="version" value={ fmt.Sprint(item.WaitlistVersion) }/><label>Priorität<input name="priority" type="number" min="-100" max="100" value={ fmt.Sprint(item.ManualPriority) }/></label><label>Kurzer Grund<input name="reason" maxlength="240" value={ item.PriorityReason } required?={ item.ManualPriority != 0 }/></label><button class="button button--quiet" type="submit">Speichern</button></form>
															<form method="post" action={ "/waitlist/" + item.WaitlistID + "/remove" } data-confirm-message={ "Auftrag " + item.JobNumber + " aus der Warteliste entfernen? Der Auftrag bleibt erhalten, muss aber erneut eingeordnet werden." }><input type="hidden" name="csrf_token" value={ data.Shell.CSRFToken }/><input type="hidden" name="version" value={ fmt.Sprint(item.WaitlistVersion) }/><input type="hidden" name="reason" value="other"/><button class="button button--danger" type="submit">Entfernen</button></form>
														}
													</div>
												</details>
											</div>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				} else {
					if waitlistHasFilters(data.Filter) {
						<div class="empty-state"><h2>Keine passenden Aufträge</h2><p>Die aktive Suche oder Filterkombination liefert keine Treffer.</p><a class="button button--quiet" href="/waitlist">Suche und Filter zurücksetzen</a></div>
					} else {
						<div class="empty-state"><h2>Warteliste ist leer</h2><p>Neue Aufträge erscheinen nach der Erfassung hier.</p><a class="button" href="/customers/new">Neuen Auftrag erfassen</a></div>
					}
				}
				@waitlistPagination(data)
			</main>@appFooter(data.Shell.Page)
		</body>
	</html>
}

templ pagination(base string, page int, total int, query string) {
	if total > 1 {
		<nav class="pagination" aria-label="Seitennavigation">
			if page > 1 {
				<a class="button button--quiet" href={ base + "?" + query + "&page=" + strconv.Itoa(page-1) }>Zurück</a>
			}
			<span>Seite { fmt.Sprint(page) } von { fmt.Sprint(total) }</span>
			if page < total {
				<a class="button button--quiet" href={ base + "?" + query + "&page=" + strconv.Itoa(page+1) }>Weiter</a>
			}
		</nav>
	}
}

templ waitlistHiddenFilter(filter customers.WaitlistFilter) {
	<input type="hidden" name="type" value={ filter.JobType }/><input type="hidden" name="region" value={ filter.Region }/><input type="hidden" name="urgency" value={ filter.Urgency }/><input type="hidden" name="month" value={ filter.PreferredMonth }/><input type="hidden" name="workflow" value={ filter.Workflow }/><input type="hidden" name="duration_group" value={ filter.DurationGroup }/><input type="hidden" name="sort" value={ filter.Sort }/><input type="hidden" name="direction" value={ filter.Direction }/>
	if filter.MissingLocation {
		<input type="hidden" name="missing_location" value="1"/>
	}
	if filter.DurationIssue {
		<input type="hidden" name="duration_issue" value="1"/>
	}
	if filter.Overdue {
		<input type="hidden" name="overdue" value="1"/>
	}
	if filter.Unassigned {
		<input type="hidden" name="unassigned" value="1"/>
	}
	if filter.TransportPending {
		<input type="hidden" name="transport_pending" value="1"/>
	}
	if filter.Incomplete {
		<input type="hidden" name="incomplete" value="1"/>
	}
}

templ waitlistSearchHiddenFields(filter customers.WaitlistFilter) {
	<input type="hidden" name="q" value={ filter.Query }/>@waitlistHiddenFilter(filter)
}

templ waitlistFilterChip(data WaitlistData, key string, label string) {
	<form method="post" action="/waitlist/search" class="waitlist-filter-chip-form">
		<input type="hidden" name="csrf_token" value={ data.Shell.CSRFToken }/>@waitlistSearchHiddenFields(data.Filter)
		<button class="button button--quiet" type="submit" name="clear" value={ key }>{ label } ×</button>
	</form>
}

templ waitlistPagination(data WaitlistData) {
	if data.Page.TotalPages > 1 {
		<nav class="pagination" aria-label="Seitennavigation">
			if data.Page.Page > 1 {
				<form method="post" action="/waitlist/search">
					<input type="hidden" name="csrf_token" value={ data.Shell.CSRFToken }/>@waitlistSearchHiddenFields(data.Filter)
					<input type="hidden" name="page" value={ strconv.Itoa(data.Page.Page - 1) }/><button class="button button--quiet" type="submit">Zurück</button>
				</form>
			}
			<span>Seite { fmt.Sprint(data.Page.Page) } von { fmt.Sprint(data.Page.TotalPages) }</span>
			if data.Page.Page < data.Page.TotalPages {
				<form method="post" action="/waitlist/search">
					<input type="hidden" name="csrf_token" value={ data.Shell.CSRFToken }/>@waitlistSearchHiddenFields(data.Filter)
					<input type="hidden" name="page" value={ strconv.Itoa(data.Page.Page + 1) }/><button class="button button--quiet" type="submit">Weiter</button>
				</form>
			}
		</nav>
	}
}

templ customerPagination(data CustomerListData) {
	if data.Page.TotalPages > 1 {
		<nav class="pagination" aria-label="Seitennavigation">
			if data.Page.Page > 1 {
				<form method="post" action="/customers/search">
					<input type="hidden" name="csrf_token" value={ data.Shell.CSRFToken }/>
					@customerFilterHiddenFields(data.Page.CustomerFilter)
					<input type="hidden" name="page" value={ strconv.Itoa(data.Page.Page - 1) }/><button class="button button--quiet" type="submit">Zurück</button>
				</form>
			}
			<span>Seite { fmt.Sprint(data.Page.Page) } von { fmt.Sprint(data.Page.TotalPages) }</span>
			if data.Page.Page < data.Page.TotalPages {
				<form method="post" action="/customers/search">
					<input type="hidden" name="csrf_token" value={ data.Shell.CSRFToken }/>
					@customerFilterHiddenFields(data.Page.CustomerFilter)
					<input type="hidden" name="page" value={ strconv.Itoa(data.Page.Page + 1) }/><button class="button button--quiet" type="submit">Weiter</button>
				</form>
			}
		</nav>
	}
}

templ customerFilterHiddenFields(filter customers.CustomerListFilter) {
	<input type="hidden" name="q" value={ filter.Search }/><input type="hidden" name="sort" value={ filter.Sort }/><input type="hidden" name="direction" value={ filter.Direction }/><input type="hidden" name="locality" value={ filter.Locality }/><input type="hidden" name="region" value={ filter.Region }/><input type="hidden" name="job_activity" value={ string(filter.JobActivity) }/><input type="hidden" name="notification" value={ string(filter.NotificationPreference) }/>
	if filter.IncludeArchived {
		<input type="hidden" name="archived" value="1"/>
	}
	if filter.MissingContact {
		<input type="hidden" name="missing_contact" value="1"/>
	}
	if filter.IncompleteAddress {
		<input type="hidden" name="incomplete_address" value="1"/>
	}
}

func customerFilterCount(filter customers.CustomerListFilter) int {
	count := 0
	if filter.MissingContact {
		count++
	}
	if filter.IncompleteAddress {
		count++
	}
	if filter.JobActivity != "" {
		count++
	}
	if filter.NotificationPreference != "" {
		count++
	}
	if filter.Locality != "" {
		count++
	}
	if filter.Region != "" {
		count++
	}
	if filter.IncludeArchived {
		count++
	}
	return count
}

func customerSortOrder(filter customers.CustomerListFilter, sortKey string) string {
	direction := "asc"
	if sortKey == "recent" || sortKey == "jobs" {
		direction = "desc"
	}
	if filter.Sort == sortKey {
		if filter.Direction == "asc" {
			direction = "desc"
		} else {
			direction = "asc"
		}
	}
	return sortKey + ":" + direction
}

func customerSortClass(filter customers.CustomerListFilter, sortKey string) string {
	if filter.Sort == sortKey {
		return "customer-sort-button is-active"
	}
	return "customer-sort-button"
}

func customerTableSortClass(filter customers.CustomerListFilter, sortKey string) string {
	if filter.Sort == sortKey {
		return "customer-table-sort is-active"
	}
	return "customer-table-sort"
}

func customerSortMark(filter customers.CustomerListFilter, sortKey string) string {
	if filter.Sort != sortKey {
		return ""
	}
	if filter.Direction == "asc" {
		return "↑"
	}
	return "↓"
}

func customerAriaSort(filter customers.CustomerListFilter, sortKey string) string {
	if filter.Sort != sortKey {
		return "none"
	}
	if filter.Direction == "asc" {
		return "ascending"
	}
	return "descending"
}

func customerName(first, last, company string) string {
	if strings.TrimSpace(company) != "" {
		return company + " · " + strings.TrimSpace(first+" "+last)
	}
	return strings.TrimSpace(first + " " + last)
}
func fallback(value string) string {
	if strings.TrimSpace(value) == "" {
		return "Nicht angegeben"
	}
	return value
}
func addressLine(c customers.Customer) string {
	return strings.TrimSpace(strings.Join([]string{c.Street, c.PostalCode, c.Locality, c.Region}, " "))
}
func durationLabel(minutes int32) string { return fmt.Sprintf("%d:%02d Std.", minutes/60, minutes%60) }
func durationInput(minutes int32) string { return fmt.Sprintf("%d:%02d", minutes/60, minutes%60) }
func optionalDurationInput(minutes int32) string {
	if minutes == 0 {
		return ""
	}
	return durationInput(minutes)
}
func ageLabel(days int32) string {
	switch {
	case days == 0:
		return "heute"
	case days <= 3:
		return "neu · 1–3 Tage"
	case days <= 7:
		return "4–7 Tage"
	case days <= 30:
		return "8–30 Tage"
	default:
		return fmt.Sprintf("älter als 30 Tage · %d Tage", days)
	}
}
func jobTypeLabel(value customers.JobType) string {
	if value == customers.JobTypeChippingWithTransport {
		return "Hackmaschine mit Transport"
	}
	return "Nur Hackmaschine"
}
func urgencyLabel(value customers.Urgency) string {
	labels := map[customers.Urgency]string{customers.UrgencyLow: "Niedrig", customers.UrgencyNormal: "Normal", customers.UrgencyHigh: "Hoch", customers.UrgencyUrgent: "Dringend"}
	return labels[value]
}
func workflowLabel(value string) string {
	labels := map[string]string{"waitlist": "Warteliste", "planning": "Planung", "scheduled": "Geplant", "completed": "Erledigt", "cancelled": "Abgebrochen"}
	return labels[value]
}
func notificationPreferenceLabel(value customers.NotificationPreference) string {
	labels := map[customers.NotificationPreference]string{customers.NotifyEmail: "✉ E-Mail", customers.NotifySMS: "▣ SMS", customers.NotifyBoth: "✉ + ▣ E-Mail und SMS", customers.NotifyNone: "Keine Benachrichtigung"}
	return labels[value]
}
func geocodingStatusLabel(value string) string {
	labels := map[string]string{"not_requested": "Noch nicht geprüft", "pending": "Prüfung ausstehend", "resolved": "Standort gefunden", "failed": "Standort nicht gefunden"}
	if label := labels[value]; label != "" {
		return label
	}
	return fallback(value)
}
func customerContactLabel(customer customers.CustomerSummary) string {
	if !customer.HasContact {
		return "Kontaktdaten fehlen"
	}
	return notificationPreferenceLabel(customer.NotificationPreference)
}
func workflowFilterLabel(value string) string {
	labels := map[string]string{"unplanned": "Ungeplant", "proposal": "Vorschlag", "scheduled": "Eingeplant"}
	return labels[value]
}
func waitlistQuery(filter customers.WaitlistFilter) string {
	values := url.Values{}
	values.Set("type", filter.JobType)
	values.Set("region", filter.Region)
	values.Set("urgency", filter.Urgency)
	values.Set("month", filter.PreferredMonth)
	values.Set("workflow", filter.Workflow)
	values.Set("duration_group", filter.DurationGroup)
	if filter.MissingLocation {
		values.Set("missing_location", "1")
	}
	if filter.DurationIssue {
		values.Set("duration_issue", "1")
	}
	if filter.Overdue {
		values.Set("overdue", "1")
	}
	if filter.Unassigned {
		values.Set("unassigned", "1")
	}
	if filter.TransportPending {
		values.Set("transport_pending", "1")
	}
	if filter.Incomplete {
		values.Set("incomplete", "1")
	}
	values.Set("sort", filter.Sort)
	values.Set("direction", filter.Direction)
	return values.Encode()
}
func waitlistHasFilters(filter customers.WaitlistFilter) bool {
	return filter.Query != "" || filter.JobType != "" || filter.Region != "" || filter.Urgency != "" || filter.PreferredMonth != "" || filter.Workflow != "" || filter.DurationGroup != "" || filter.MissingLocation || filter.DurationIssue || filter.Overdue || filter.Unassigned || filter.TransportPending || filter.Incomplete
}
func waitlistFilterCount(filter customers.WaitlistFilter) int {
	count := 0
	for _, value := range []string{filter.JobType, filter.Region, filter.Urgency, filter.PreferredMonth, filter.Workflow, filter.DurationGroup} {
		if value != "" {
			count++
		}
	}
	for _, active := range []bool{filter.MissingLocation, filter.DurationIssue, filter.Overdue, filter.Unassigned, filter.TransportPending, filter.Incomplete} {
		if active {
			count++
		}
	}
	return count
}

func waitlistSortOrder(filter customers.WaitlistFilter, sortKey string) string {
	direction := "asc"
	if sortKey == "urgency" || sortKey == "volume" || sortKey == "duration" || sortKey == "updated" {
		direction = "desc"
	}
	if filter.Sort == sortKey {
		if filter.Direction == "asc" {
			direction = "desc"
		} else {
			direction = "asc"
		}
	}
	return sortKey + ":" + direction
}

func waitlistSortClass(filter customers.WaitlistFilter, sortKey string) string {
	if filter.Sort == sortKey {
		return "customer-sort-button is-active"
	}
	return "customer-sort-button"
}

func waitlistTableSortClass(filter customers.WaitlistFilter, sortKey string) string {
	if filter.Sort == sortKey {
		return "customer-table-sort is-active"
	}
	return "customer-table-sort"
}

func waitlistSortMark(filter customers.WaitlistFilter, sortKey string) string {
	if filter.Sort != sortKey {
		return ""
	}
	if filter.Direction == "asc" {
		return "↑"
	}
	return "↓"
}

func waitlistAriaSort(filter customers.WaitlistFilter, sortKey string) string {
	if filter.Sort != sortKey {
		return "none"
	}
	if filter.Direction == "asc" {
		return "ascending"
	}
	return "descending"
}

func preferenceModeLabel(value customers.PreferenceMode) string {
	switch value {
	case customers.PreferenceFixed:
		return "fixes Datum"
	case customers.PreferenceFlexible:
		return "flexibel"
	default:
		return "Zeitraum"
	}
}
func waitlistRegions(items []customers.WaitlistItem) []string {
	seen := map[string]bool{}
	regions := make([]string, 0, 5)
	for _, item := range items {
		value := strings.TrimSpace(item.Region)
		if value != "" && !seen[value] {
			seen[value] = true
			regions = append(regions, value)
			if len(regions) == 5 {
				break
			}
		}
	}
	return regions
}

func formattedCustomerAddress(street, postalCode, locality, region, countryCode, freeform string) string {
	localityLine := strings.TrimSpace(strings.Join([]string{strings.TrimSpace(postalCode), strings.TrimSpace(locality)}, " "))
	parts := []string{strings.TrimSpace(street), localityLine, strings.TrimSpace(region)}
	clean := make([]string, 0, len(parts))
	for _, part := range parts {
		if part != "" {
			clean = append(clean, part)
		}
	}
	if len(clean) == 0 {
		return strings.TrimSpace(freeform)
	}
	if countryCode = strings.TrimSpace(countryCode); countryCode != "" {
		clean = append(clean, countryCode)
	}
	return strings.Join(clean, ", ")
}

func intakeCustomerAddress(values IntakeValues) string {
	return formattedCustomerAddress(values.Street, values.PostalCode, values.Locality, values.Region, "AT", values.AddressFreeform)
}

func customerAddress(customer customers.Customer) string {
	return formattedCustomerAddress(customer.Street, customer.PostalCode, customer.Locality, customer.Region, customer.CountryCode, customer.AddressFreeform)
}

func customerAddressHint(address string) string {
	if address == "" {
		return "Adresse aus den aktuellen Kundendaten verwenden"
	}
	return address
}
